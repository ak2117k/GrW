# ============================================
# TD Automation - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# ---- Angel One SmartAPI ----
ANGEL_ONE_API_KEY=your_api_key_here
ANGEL_ONE_CLIENT_ID=your_client_id_here
ANGEL_ONE_PASSWORD=your_password_here
ANGEL_ONE_TOTP_SECRET=your_totp_secret_here

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://postgres:password@localhost:5432/td_automation
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=td_automation
DATABASE_USER=postgres
DATABASE_PASSWORD=password

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- Backend ----
API_PORT=3001
API_HOST=localhost
JWT_SECRET=change_this_to_a_random_string
JWT_EXPIRY=7d
ENCRYPTION_KEY=change_this_32_char_encryption_key

# ---- Frontend ----
VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001

# ---- AI Engine (Python) ----
AI_ENGINE_URL=http://localhost:5000
AI_ENGINE_PORT=5000

# ---- Trading Configuration ----
# Paper trading mode (true = simulated, false = real money)
PAPER_TRADING=true
# HARD live-order backstop. Must be exactly "true" to allow ANY real order to
# reach the broker — even when a per-order isPaper:false is sent. Any other value
# (or unset) keeps live order placement disabled. Paper trading is unaffected.
LIVE_TRADING_ENABLED=false
# Ungated shadow track: admit ONLY signals from the Hull scanner (the scanner the
# profit is concentrated in). Default ON. Set to "false" to revert the ungated
# track to admitting all scanners. Any value other than "false" keeps it ON.
UNGATED_HULL_ONLY=true
# Max daily loss in INR (auto-trade stops when reached)
MAX_DAILY_LOSS=5000
# Max concurrent positions
MAX_CONCURRENT_POSITIONS=5
# Max capital per trade in INR
MAX_CAPITAL_PER_TRADE=50000

# ---- News APIs ----
# Optional: Add API keys for premium news sources
# NEWS_API_KEY=your_news_api_key

# ---- Chartink Integration ----
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Chartink scanners POST alerts to /webhooks/chartink/<this-value>.
# Must be set for the webhook controller to accept any request.
CHARTINK_WEBHOOK_SECRET=

# ---- Logging ----
LOG_LEVEL=info
LOG_FILE=td-automation.log
