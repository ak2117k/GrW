# =============================================================================
# GrW — PRODUCTION env template (free-tier: Render API + Neon + Upstash + Pages)
# =============================================================================
# There are NO .env files in the container. apps/api/src/load-env.ts runs
# dotenv.config() which just no-ops in prod, so EVERY value below must be set as
# a host (Render) environment variable. Set the `sync:false` secrets in the
# Render dashboard; commit NONE of the real values.
#
# In production (NODE_ENV=production) the app FAILS CLOSED at boot
# (validate-boot-config.ts) unless the required vars are present and valid.

# ---- Runtime mode ----
NODE_ENV=production
# Paper mode only. LIVE_TRADING_ENABLED must be exactly "true" to ever place a
# real broker order; anything else keeps live orders disabled.
PAPER_TRADING=true
LIVE_TRADING_ENABLED=false

# ---- Port (host-injected) ----
# DO NOT hardcode. Render injects PORT (e.g. 10000); main.ts binds
# process.env.PORT ?? API_PORT ?? 4101 on 0.0.0.0. Leave PORT unset locally.
# PORT=

# ---- Auth / crypto secrets (REQUIRED, no defaults) ----
# Random 32+ char strings.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
# REQUIRED and MUST be >= 32 chars in production. Must NOT equal the public
# sentinel 'td-automation-default-key-change-me'. Derives the data-encryption key.
ENCRYPTION_KEY=
JWT_EXPIRY=7d

# ---- Database: Neon Postgres (REQUIRED) ----
# Use the POOLED connection string and keep sslmode=require — prod boot rejects a
# DATABASE_URL without sslmode=require|verify-full|verify-ca. Append
# &connect_timeout=30: Neon free autosuspends and the first query after idle
# needs >5s (Prisma default) to wake the compute, else it fails P1001.
# postgresql://<user>:<pass>@ep-xxxx-pooler.<region>.aws.neon.tech/neondb?sslmode=require&connect_timeout=30
DATABASE_URL=
# DIRECT (unpooled) URL for Prisma Migrate — same as DATABASE_URL but host has NO
# `-pooler`. `prisma migrate deploy` hangs on Neon's pooled PgBouncer endpoint
# (session advisory lock), so migrations run over this direct connection while
# the app keeps using the pooled DATABASE_URL. Keep sslmode=require.
# postgresql://<user>:<pass>@ep-xxxx.<region>.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=

# ---- CORS: Cloudflare Pages origin (REQUIRED in prod) ----
# Fail-closed allowlist. Set to the exact Pages URL, NO trailing slash. If wrong
# or unset, browser calls (including login) are blocked. Comma-separate for more.
# e.g. https://grw.pages.dev
WEB_ORIGIN=

# ---- Redis: Render Key Value, internal endpoint (REQUIRED in prod) ----
# The app reads REDIS_HOST / REDIS_PORT / REDIS_PASSWORD (NOT a single REDIS_URL).
# Use Render Key Value's INTERNAL connection — it's on Render's private network,
# so it always resolves (external Upstash did NOT resolve from Render:
# getaddrinfo ENOTFOUND). Internal traffic is plaintext, hence:
#   REDIS_TLS=false + REDIS_ALLOW_PLAINTEXT=true  (boot otherwise requires TLS).
# Leave REDIS_FAMILY unset (private network may be IPv6 — do not force IPv4).
# For an EXTERNAL TLS Redis instead: REDIS_TLS=true and drop REDIS_ALLOW_PLAINTEXT.
REDIS_TLS=false
REDIS_ALLOW_PLAINTEXT=true
REDIS_THROTTLER=true
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
# REDIS_FAMILY=      # leave unset for dual-stack; set 4 only to force IPv4

# ---- AI engine (REQUIRED to be https in prod) ----
# The free stack ships no Python AI sidecar. Prod boot only checks the URL is
# https; a placeholder satisfies it (paper mode never calls the engine).
AI_ENGINE_URL=https://ai-engine.invalid

# ---- Billing (keep off for the free/paper deploy) ----
# 'fake' avoids the Razorpay SDK + credentials entirely.
BILLING_PROVIDER=fake
LIVE_BILLING_ENABLED=false

# ---- Optional tuning (safe defaults exist) ----
# GLOBAL_RATE_LIMIT=120
# GLOBAL_RATE_TTL=60000
# CHARTINK_WEBHOOK_SECRET=
# ML_TRIGGER_SECRET=
