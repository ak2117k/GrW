# Telegram listener config (single-machine deployment).
# Copy to `ai-engine/.env` and fill in. NEVER commit the filled-in .env —
# TELEGRAM_SESSION is full account access.
#
# The parser runs in-process via the Claude Agent SDK, so this host must be
# logged into Claude Code (your Max plan). No ANTHROPIC_API_KEY needed.

# --- Telegram app (from https://my.telegram.org → API development tools) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- Login session (from: py scripts/telegram-login.py) ---
TELEGRAM_SESSION=

# --- Channels to watch: comma-separated NUMERIC channel ids (e.g. -1001234567890) ---
# Get ids by joining the channels with this account, then listing dialogs
# (the runbook shows a one-liner). Public @handles are resolved to ids by Telethon.
TELEGRAM_WATCH_CHANNELS=

# --- Where parsed signals are POSTed (your deployed Render API) ---
TELEGRAM_INGEST_URL=https://grw-api.onrender.com/webhooks/telegram/ingest

# --- Shared secret — MUST equal grw-api's TELEGRAM_INGEST_SECRET in Render ---
TELEGRAM_INGEST_SECRET=
