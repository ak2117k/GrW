FROM python:3.12-slim
# LightGBM's wheel links OpenMP at runtime.
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements-mbm-serve.txt .
RUN pip install --no-cache-dir -r requirements-mbm-serve.txt
COPY src ./src
ENV PYTHONUNBUFFERED=1 MODELS_DIR=/models MBM_INSTRUMENTS=NIFTY TZ=Asia/Kolkata
EXPOSE 5100
# Minimal app: only /behaviour and /health (never imports src/main.py or sklearn). One worker:
# the loop must run exactly once.
CMD ["uvicorn", "src.mbm_main:app", "--host", "0.0.0.0", "--port", "5100", "--workers", "1"]
