T10:15:00.000Z"},"sp500Futures":{"available":false,"reason":"not fetched yet"},"giftNifty":{"available":false,"reason":"GIFT Nifty is read in the 23:45 and 08:30 reviews"},"fiiDerivatives":{"available":true,"value":{"session":"2026-10-09","indexFutures":{"long":1,"short":2,"net":-1}},"source":"NSE participant OI","at":"2026-10-09"},"crudeOil":{"available":true,"value":{"value":5600,"change":-84,"changePercent":-1.5,"direction":"DOWN","ageMinutes":5,"basis":"quote time"},"source":"commodities","at":"2026-10-12T10:15:00.000Z"},"gold":{"available":false,"reason":"no quote"},"fiiFlows":{"available":true,"value":{"session":"2026-10-09","fii":{"buy":1,"sell":2,"net":-1},"todaysFigure":"not yet published (NSE publishes ~18:00–20:00 IST)"},"source":"NSE fiidiiTradeReact","at":"2026-10-09"},"indiaVix":{"available":true,"value":{"value":13.4,"change":0.6,"changePercent":4.7,"direction":"UP","ageMinutes":0,"basis":"previous session close"},"source":"market-context.service","at":"2026-10-12T10:15:00.000Z"},"sectorStrength":{"available":false,"reason":"underlying is an index"},"underlyingChange":{"available":false,"reason":"no previous close"}}}}",
