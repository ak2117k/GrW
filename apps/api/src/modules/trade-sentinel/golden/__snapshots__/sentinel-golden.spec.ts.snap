e":"derived from IST wall clock","at":"2026-08-14T04:30:00.000Z"},"expiry":null},"trigger":{"available":true,"value":[{"name":"heartbeat","detail":"scheduled review"}],"source":"tripwire.service","at":"2026-08-14T04:30:00.000Z"},"memory":{"available":false,"reason":"no prior verdicts for this position — this is the first look"}}",
