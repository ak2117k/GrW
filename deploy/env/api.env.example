# Copy to /opt/grw/env/api.env on the server, chmod 600. Never commit the real file.
# RULE: copy EVERY key from Render → grw-api → Environment first, then apply the
# overrides below. DATABASE_URL / DIRECT_URL / REDIS_* are set by the compose file
# and must NOT appear here.

NODE_ENV=production
PAPER_TRADING=true
LIVE_TRADING_ENABLED=false
BILLING_PROVIDER=fake
LIVE_BILLING_ENABLED=false
REDIS_THROTTLER=true
CRON_LEASE_ENABLED=true

# MUST be byte-identical to Render's values (encrypted broker credentials, live sessions).
JWT_SECRET=
ENCRYPTION_KEY=

WEB_ORIGIN=https://grw.ak-2117k.workers.dev
CHARTINK_WEBHOOK_SECRET=
ML_TRIGGER_SECRET=
TELEGRAM_INGEST_SECRET=
# Legacy AI engine for ai-advisor / weekly-report. Do NOT point this at the SP3 scorer
# container: it does not serve those routes. The scorer has its own URL below.
AI_ENGINE_URL=https://ai-engine.invalid
# SP3 entry scorer (ScorerClient -> ${AI_SCORER_URL}/score). Unset = scorer "unavailable"
# (fail-open, warned at most once a minute). Once the ai-engine compose service runs
# (--profile ai), set it to the internal host (the boot validator accepts plain http only
# for exactly http://ai-engine[:port]; anything else must be https):
# AI_SCORER_URL=http://ai-engine:5000

# Sentinel on the owner's Claude subscription (personal MVP only — see spec §9.4).
SENTINEL_SHADOW_ENABLED=true
SENTINEL_JUDGE=cli
CLAUDE_CODE_OAUTH_TOKEN=
SENTINEL_MODEL_TRIGGERED=claude-opus-5-5
SENTINEL_EFFORT_TRIGGERED=high
SENTINEL_MODEL_ROUTINE=claude-sonnet-5-5
SENTINEL_EFFORT_ROUTINE=medium
# Sentinel auto-exit (docs/superpowers/specs/2026-10-12-sentinel-auto-exit-design.md).
# Places a closing order on Angel One when the sentinel says EXIT_NOW. OFF by default.
# Off = no timer, no query, no broker call. Turn off: AI_AUTO_EXIT_ENABLED=false + restart.
AI_AUTO_EXIT_ENABLED=false
# dry-run = everything except the order (rows status DRY_RUN). live = real orders.
AI_AUTO_EXIT_MODE=dry-run
# Comma-separated user ids allowed to be auto-exited (the owner only).
AI_AUTO_EXIT_USER_IDS=
AI_AUTO_EXIT_DAILY_CAP=5
AI_AUTO_EXIT_MAX_VERDICT_AGE_SEC=90
AI_AUTO_EXIT_LIMIT_FALLBACK_PCT=2
# Order quantity unit per exchange, EXCHANGE:units|lots (ruling R16). Empty = NFO/BFO units,
# MCX UNCONFIGURED (MCX exits are dry-run only until set, after the dry-run MCX check).
AI_AUTO_EXIT_QTY_UNITS=
# Cancel the owner's protective stop-loss / target, then exit (plan: "Cancel protective then exit").
# false (default) = a position with ANY resting order is refused OPEN_ORDER_EXISTS. true = when EVERY
# resting order on the contract is exit-side SL/SL-M/LIMIT, <= the position, same product, cancel it,
# confirm in the order book, then exit. Applies to AI and the owner's Exit button. REAL cancels.
# If the exit then fails the position is UNPROTECTED (reason UNPROTECTED_AFTER_CANCEL:*); the SL is not re-placed.
AI_AUTO_EXIT_CANCEL_PROTECTIVE=false
# Exit discipline (docs/superpowers/specs/2026-10-14-exit-discipline-design.md). ON unless exactly false.
# Off = today's floor/giveback and no AI exit gate/persistence (fill capture + outcome scoring still run).
# Also switches the sentinel prompt's exit-discipline lines and the packet's money.floorBasis / flow.noiseUnit (off = v5/v6 text, byte-identical).
EXIT_DISCIPLINE_ENABLED=true
# Floor arms when the best excursion is >= FLOOR_ARM_N noise units beyond breakeven-after-charges,
# then trails the peak by FLOOR_TRAIL_N units (tighten-only).
FLOOR_ARM_N=1.5
FLOOR_TRAIL_N=2.0
# Giveback sensor fires only on a pullback >= GIVEBACK_N units after an excursion >= FLOOR_ARM_N units.
GIVEBACK_N=1.5
# Gate: intraday positions may be exited by the AI in the last GATE_CLOSE_MIN minutes (hard risk).
GATE_CLOSE_MIN=10
# Gate: a floor breach counts only if the underlying moved >= GATE_UNDERLYING_N of its noise units against the position.
GATE_UNDERLYING_N=1.0
# Persistence: a second EXIT_NOW within PERSIST_WINDOW_SEC, or EXIT_NOW sustained >= PERSIST_MIN_SEC without a HOLD.
PERSIST_WINDOW_SEC=300
PERSIST_MIN_SEC=120
# Post-exit scoring window (minutes after the decision, capped at the exchange close).
EXIT_OUTCOME_WINDOW_MIN=60

# --- Sentinel price triggers (docs/superpowers/specs/2026-10-13-sentinel-price-triggers-design.md) ---
# The judge's machine-readable exit level, armed and executed by a tick watcher
# through the SAME guarded executor (needs AI_AUTO_EXIT_ENABLED=true and an
# allow-listed user; dry-run/live = AI_AUTO_EXIT_MODE; counts toward the daily cap).
# Needs the market hub for that user: MARKET_HUB_ENABLED, HUB_OWNER_USER_ID, HUB_PRICES_POSITIONS=true.
# Off = no timer, no watch, no query. Turn off: SENTINEL_TRIGGERS_ENABLED=false + restart.
# Also switches the sentinel prompt's exitTrigger rules and its "may be executed automatically" sentence (exactly true = on).
SENTINEL_TRIGGERS_ENABLED=false
# Confirmation: this many consecutive ticks beyond the level AND for at least this long (owner D2).
SENTINEL_TRIGGER_CONFIRM_TICKS=2
SENTINEL_TRIGGER_CONFIRM_MS=1000
# An armed level not renewed by a newer verdict expires after this many minutes.
SENTINEL_TRIGGER_MAX_AGE_MIN=240
# A level further than this from the live price is refused (per instrument).
SENTINEL_TRIGGER_MAX_DISTANCE_PCT=UNDERLYING:10,PREMIUM:60
# D4: a later level may only move toward the price. Only the exact string false disables.
SENTINEL_TRIGGER_TIGHTEN_ONLY=true
# Part B: level-break / giveback also evaluated on hub ticks (wakes the judge in ~1 s).
# Only when SENTINEL_SHADOW_ENABLED=true. Off: SENTINEL_TICK_TRIPWIRES=false.
SENTINEL_TICK_TRIPWIRES=true
# Re-judge suppression: an unchanged repeat of giveback-off-peak / volume-anomaly does
# not re-wake the judge until the cooldown elapses, qty changes, the contract moves
# PRICE_MOVE_PCT, the giveback finds a new peak or deepens (DEEPEN_N noise units, else
# DEEPEN_FRAC of the excursion), or a new volume bar closes. Never suppresses a wake that
# carries any other sensor (level-break, exit-confirm, news, ...). Rollback: =false.
SENTINEL_REJUDGE_SUPPRESSION=true
SENTINEL_REJUDGE_COOLDOWN_MIN=10
SENTINEL_REJUDGE_PRICE_MOVE_PCT=0.02
SENTINEL_REJUDGE_GIVEBACK_DEEPEN_N=0.5
SENTINEL_REJUDGE_GIVEBACK_DEEPEN_FRAC=0.1
# SP3 AI gateway. AI_GATEWAY_SENTINEL=true serves the sentinel's calls through the
# gateway (same provider from SENTINEL_JUDGE, same request/reply, + an ai_calls audit
# row). Default off: anything but `true` keeps today's direct binding.
# BEFORE turning it on: ai_calls stores every request + response in full (the sentinel's
# system prompt and packet, often tens of KB per call) and has NO retention/pruning job yet.
# Add a retention policy (or a size check) first, or the table grows without bound.
AI_GATEWAY_SENTINEL=false
# Daily cap on metered API spend (INR, per IST day); 25% is reserved for position
# reviews. CLI calls cost 0. An API call to a model missing from
# config/ai-model-prices.json is refused.
AI_API_DAILY_CAP_INR=100
# Concurrent `claude -p` subprocesses (shares the owner's subscription window).
# With AI_GATEWAY_SENTINEL=true set this to >= 3: the sentinel already runs up to
# JUDGE_CONCURRENCY=2 judgements at once PLUS thesis calls, all of which now queue on this
# limit; at 2 a thesis call waits behind both judges (a CLI call can take up to 180 s) --
# a delay the direct binding never had.
AI_CLI_CONCURRENCY=2

# SP1 market data hub. M1: shadow prices (no consumer reads them yet).
# M2 adds the CandleStore behind HUB_CANDLES_ENABLED / HUB_SERVES_CHARTS; M3 adds HUB_PRICES_POSITIONS / HUB_PRICES_TRACKS.
MARKET_HUB_ENABLED=false
# Your own GrW user id (users.id); the hub shares YOUR Angel One session.
HUB_OWNER_USER_ID=
HUB_SLOT_CAP=50
# MCX late-close season(s): MCX closes 23:55 IST (not 23:30) while the US is OFF daylight saving.
# Inclusive IST date ranges from:to, comma-separated; renew each autumn from the MCX circular.
# Read by the market hub AND the trade sentinel (packet minutesToClose, live tick gate, overnight
# reviews). Left empty, a live MCX position is treated as closed at 23:30 all winter.
HUB_MCX_LATE_CLOSE=2026-11-02:2027-03-08
# SP1 M2 CandleStore: tick-built 1m bars + gap fill + nightly fix-up (needs MARKET_HUB_ENABLED=true).
HUB_CANDLES_ENABLED=false
# M2 switch: charts read candles from the hub. Set false to revert to the legacy path for a session.
HUB_SERVES_CHARTS=false
# SP1 M3 switches (each needs MARKET_HUB_ENABLED=true; set false to revert that consumer for a session).
# Trade-tracker sweep + hub tick listener + sentinel tick source read the hub's prices for YOUR positions.
HUB_PRICES_POSITIONS=false
# ExitPriceService (track pollers, breakout-swing, EOD square-offs) reads the hub's prices.
HUB_PRICES_TRACKS=false
# SP1 M4 switch (needs MARKET_HUB_ENABLED=true): YOUR browser is fed by the hub and stops polling while Live.
HUB_SERVES_BROWSER=false
# SP1 M5 switch (needs MARKET_HUB_ENABLED=true): option chains built by the hub. Off = NSE scrape + legacy.
HUB_SERVES_CHAIN=false
# SP1 M5: 3-minute OI snapshots (baseline for "OI change vs yesterday"). Keep on even while HUB_SERVES_CHAIN is off.
HUB_OI_SNAPSHOT_ENABLED=true
# SP1 M5: always-snapshotted underlyings (exact master names) and chain width (strikes each side of ATM).
HUB_OI_CORE_UNDERLYINGS=NIFTY,BANKNIFTY,FINNIFTY,MIDCPNIFTY,CRUDEOIL,NATURALGAS
HUB_CHAIN_STRIKES_AROUND=20

# Near-live broker position tracking (trade trackers), on top of the 10-minute reconcile cron.
# Both read POSITIONS only (holdings stay on the 10-min cron) and only over a user's LIVE per-user
# feed session (the one the market hub holds for you) — never a second Angel login.
# A) Angel One order-update WebSocket (wss://tns.angelone.in/smart-order-update) on that session's
#    tokens: a fill / partial fill / cancel / reject reconciles the user after a debounce (~2-4 s).
#    Open only while an exchange is in session. Set false to turn off (the poll below still runs).
LIVE_SYNC_ORDER_STREAM_ENABLED=true
# Whose account the stream watches. Blank = HUB_OWNER_USER_ID.
LIVE_SYNC_ORDER_STREAM_USER_ID=
# Debounce (ms) after the last order update before the reconcile (bounded 500-30000).
LIVE_SYNC_DEBOUNCE_MS=2000
# B) Adaptive poll: while a user has an OPEN position on an exchange in session (and a live feed
#    session), one getPosition every LIVE_SYNC_POLL_MS (minimum 30000). Set false to turn off.
LIVE_SYNC_POLL_ENABLED=true
LIVE_SYNC_POLL_MS=60000
# NSE option chain endpoints (OI/PCR/max pain). Blank = built-in defaults; override when NSE moves them.
# Defaults: https://www.nseindia.com/api/option-chain-contract-info and https://www.nseindia.com/api/option-chain-v3
NSE_OPTION_CHAIN_INFO_URL=
NSE_OPTION_CHAIN_V3_URL=
# NSE chain wait (ms) for the /options chain endpoints. Hot paths (sentinel tick, 30 s sweeps, scans, trade-entry context) stay at 3000.
NSE_OPTION_CHAIN_TIMEOUT_MS=8000

# News ingestion (every 5 min, weekdays 08:00–23:30 IST). Commodities RSS for the MCX underlyings
# (crude, gold, silver, natural gas, copper are tagged from headline keywords). Blank = the built-in
# Economic Times commodities feed (https://economictimes.indiatimes.com/markets/commodities/rssfeeds/1808152121.cms);
# `off` drops the source.
NEWS_COMMODITIES_RSS_URL=

# Market cues for the sentinel's overnight/pre-open reviews (US closes + index futures, FII/DII cash,
# FII index F&O OI, GIFT Nifty, NSE pre-open IEPs). Free unofficial sources: OWNER'S OWN SHADOW
# SENTINEL ONLY — showing them to SaaS tenants needs a licensed vendor. Master switch, default off.
#
# What turning it on gives (all fully built behind this flag; HTTP only, no broker calls, no feed slots):
#  - Live packet macro.fiiDii: the latest published FII/DII cash flows (NSE, NSDL fallback), post-close context.
#  - Live packet macro.globalCues: Nasdaq/S&P/Dow closes or intraday values, Nasdaq-100/S&P futures, GIFT Nifty
#    vs the NSE NIFTY future close; on MCX positions also the commodity benchmark(s) + USD/INR.
#  - Overnight/pre-open reviews: the same plus FII index F&O positioning and the NSE pre-open IEPs.
#  - The live sentinel switches from prompt v2.1 (macro always unavailable) to the current cues prompt (v4).
# Off: no request is sent and macro.fiiDii / macro.globalCues stay unavailable with the reason.
MARKET_CUES_ENABLED=false
# Per-source switches (default true beneath the master switch).
MARKET_CUES_US=true
# MCX commodity benchmarks for the sentinel's macro.globalCues on MCX positions: NYMEX WTI (@CL.1), ICE Brent
# (@LCO.1), COMEX gold/silver/copper (@GC.1/@SI.1/@HG.1), NYMEX natural gas (@NG.1) and USD/INR (INR=), all in ONE
# CNBC quote request (MARKET_CUES_CNBC_QUOTE_URL) every 10 min, weekdays 09:00–23:30 IST, plus 23:40 and 08:25.
MARKET_CUES_COMMODITIES=true
MARKET_CUES_FII=true
MARKET_CUES_FII_OI=true
MARKET_CUES_GIFT=true
MARKET_CUES_PREOPEN=true
# Per-request timeout (ms); one retry after MARKET_CUES_RETRY_DELAY_MS; then per-endpoint backoff
# starting at MARKET_CUES_BACKOFF_MS and doubling up to MARKET_CUES_BACKOFF_MAX_MS.
MARKET_CUES_TIMEOUT_MS=10000
MARKET_CUES_RETRY_DELAY_MS=2000
MARKET_CUES_BACKOFF_MS=300000
MARKET_CUES_BACKOFF_MAX_MS=3600000
# Request headers (no cookies are ever sent). Blank = the built-in browser UA / application/json.
MARKET_CUES_USER_AGENT=
MARKET_CUES_ACCEPT=application/json
# Endpoint overrides — blank = the verified defaults shown. {symbol}, {symbols}, {DDMMYYYY} are filled in.
MARKET_CUES_YAHOO_CHART_URL=https://query1.finance.yahoo.com/v8/finance/chart/{symbol}?range=5d&interval=1d
MARKET_CUES_CNBC_QUOTE_URL=https://quote.cnbc.com/quote-html-webservice/restQuote/symbolType/symbol?symbols={symbols}&requestMethod=itv&noform=1&partnerId=2&fund=1&exthrs=1&output=json
MARKET_CUES_NSE_FIIDII_URL=https://www.nseindia.com/api/fiidiiTradeReact
MARKET_CUES_NSDL_FPI_URL=https://www.fpi.nsdl.co.in/web/Reports/Latest.aspx
MARKET_CUES_NSE_PARTICIPANT_OI_URL=https://nsearchives.nseindia.com/content/nsccl/fao_participant_oi_{DDMMYYYY}.csv
MARKET_CUES_NSEIX_URL=https://www.nseix.com/api/market-rate?type=derivative
MARKET_CUES_NSE_MARKET_STATUS_URL=https://www.nseindia.com/api/marketStatus
MARKET_CUES_NSE_NIFTY_FUTURES_URL=https://www.nseindia.com/api/liveEquity-derivatives?index=nse50_fut
MARKET_CUES_NSE_PREOPEN_URL=https://www.nseindia.com/api/market-data-pre-open?key=FO

# ─── News & events v2 (docs/superpowers/specs/2026-10-16-news-events-design.md) ───
# false = today (nothing new runs) | observe = compute + log, packet/prompt unchanged | true = the judge sees it.
NEWS_EVENTS_V2_ENABLED=false
NEWS_NSE_ANN_CADENCE_MIN=3
NEWS_INDEX_HOURS=24
NEWS_INDEX_MAX_ITEMS=5000
NEWS_WAKE_COOLDOWN_MIN=5
EVENT_WAKE_LEAD_MIN=15
EVENTS_HORIZON_TRADING_DAYS=3
