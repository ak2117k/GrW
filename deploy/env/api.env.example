# Copy to /opt/grw/env/api.env on the server, chmod 600. Never commit the real file.
# RULE: copy EVERY key from Render → grw-api → Environment first, then apply the
# overrides below. DATABASE_URL / DIRECT_URL / REDIS_* are set by the compose file
# and must NOT appear here.

NODE_ENV=production
PAPER_TRADING=true
LIVE_TRADING_ENABLED=false
BILLING_PROVIDER=fake
LIVE_BILLING_ENABLED=false
REDIS_THROTTLER=true
CRON_LEASE_ENABLED=true

# MUST be byte-identical to Render's values (encrypted broker credentials, live sessions).
JWT_SECRET=
ENCRYPTION_KEY=

WEB_ORIGIN=https://grw.ak-2117k.workers.dev
CHARTINK_WEBHOOK_SECRET=
ML_TRIGGER_SECRET=
TELEGRAM_INGEST_SECRET=
AI_ENGINE_URL=https://ai-engine.invalid

# Sentinel on the owner's Claude subscription (personal MVP only — see spec §9.4).
SENTINEL_SHADOW_ENABLED=true
SENTINEL_JUDGE=cli
CLAUDE_CODE_OAUTH_TOKEN=
SENTINEL_MODEL_TRIGGERED=claude-opus-5-5
SENTINEL_EFFORT_TRIGGERED=high
SENTINEL_MODEL_ROUTINE=claude-sonnet-5-5
SENTINEL_EFFORT_ROUTINE=medium
# SP3 AI gateway. AI_GATEWAY_SENTINEL=true serves the sentinel's calls through the
# gateway (same provider from SENTINEL_JUDGE, same request/reply, + an ai_calls audit
# row). Default off: anything but `true` keeps today's direct binding.
AI_GATEWAY_SENTINEL=false
# Daily cap on metered API spend (INR, per IST day); 25% is reserved for position
# reviews. CLI calls cost 0. An API call to a model missing from
# config/ai-model-prices.json is refused.
AI_API_DAILY_CAP_INR=100
# Concurrent `claude -p` subprocesses (shares the owner's subscription window).
AI_CLI_CONCURRENCY=2

# SP1 market data hub. M1: shadow prices (no consumer reads them yet).
# M2 adds the CandleStore behind HUB_CANDLES_ENABLED / HUB_SERVES_CHARTS; M3 adds HUB_PRICES_POSITIONS / HUB_PRICES_TRACKS.
MARKET_HUB_ENABLED=false
# Your own GrW user id (users.id); the hub shares YOUR Angel One session.
HUB_OWNER_USER_ID=
HUB_SLOT_CAP=50
# MCX 23:55 close windows, e.g. 2026-11-02:2027-03-08
HUB_MCX_LATE_CLOSE=
# SP1 M2 CandleStore: tick-built 1m bars + gap fill + nightly fix-up (needs MARKET_HUB_ENABLED=true).
HUB_CANDLES_ENABLED=false
# M2 switch: charts read candles from the hub. Set false to revert to the legacy path for a session.
HUB_SERVES_CHARTS=false
# SP1 M3 switches (each needs MARKET_HUB_ENABLED=true; set false to revert that consumer for a session).
# Trade-tracker sweep + hub tick listener + sentinel tick source read the hub's prices for YOUR positions.
HUB_PRICES_POSITIONS=false
# ExitPriceService (track pollers, breakout-swing, EOD square-offs) reads the hub's prices.
HUB_PRICES_TRACKS=false
# SP1 M4 switch (needs MARKET_HUB_ENABLED=true): YOUR browser is fed by the hub and stops polling while Live.
HUB_SERVES_BROWSER=false
# NSE option chain endpoints (OI/PCR/max pain). Blank = built-in defaults; override when NSE moves them.
# Defaults: https://www.nseindia.com/api/option-chain-contract-info and https://www.nseindia.com/api/option-chain-v3
NSE_OPTION_CHAIN_INFO_URL=
NSE_OPTION_CHAIN_V3_URL=
# NSE chain wait (ms) for the /options chain endpoints. Hot paths (sentinel tick, 30 s sweeps, scans, trade-entry context) stay at 3000.
NSE_OPTION_CHAIN_TIMEOUT_MS=8000

# Market cues for the sentinel's overnight/pre-open reviews (US closes + index futures, FII/DII cash,
# FII index F&O OI, GIFT Nifty, NSE pre-open IEPs). Free unofficial sources: OWNER'S OWN SHADOW
# SENTINEL ONLY — showing them to SaaS tenants needs a licensed vendor. Master switch, default off.
MARKET_CUES_ENABLED=false
# Per-source switches (default true beneath the master switch).
MARKET_CUES_US=true
MARKET_CUES_FII=true
MARKET_CUES_FII_OI=true
MARKET_CUES_GIFT=true
MARKET_CUES_PREOPEN=true
# Per-request timeout (ms); one retry after MARKET_CUES_RETRY_DELAY_MS; then per-endpoint backoff
# starting at MARKET_CUES_BACKOFF_MS and doubling up to MARKET_CUES_BACKOFF_MAX_MS.
MARKET_CUES_TIMEOUT_MS=10000
MARKET_CUES_RETRY_DELAY_MS=2000
MARKET_CUES_BACKOFF_MS=300000
MARKET_CUES_BACKOFF_MAX_MS=3600000
# Request headers (no cookies are ever sent). Blank = the built-in browser UA / application/json.
MARKET_CUES_USER_AGENT=
MARKET_CUES_ACCEPT=application/json
# Endpoint overrides — blank = the verified defaults shown. {symbol}, {symbols}, {DDMMYYYY} are filled in.
MARKET_CUES_YAHOO_CHART_URL=https://query1.finance.yahoo.com/v8/finance/chart/{symbol}?range=5d&interval=1d
MARKET_CUES_CNBC_QUOTE_URL=https://quote.cnbc.com/quote-html-webservice/restQuote/symbolType/symbol?symbols={symbols}&requestMethod=itv&noform=1&partnerId=2&fund=1&exthrs=1&output=json
MARKET_CUES_NSE_FIIDII_URL=https://www.nseindia.com/api/fiidiiTradeReact
MARKET_CUES_NSDL_FPI_URL=https://www.fpi.nsdl.co.in/web/Reports/Latest.aspx
MARKET_CUES_NSE_PARTICIPANT_OI_URL=https://nsearchives.nseindia.com/content/nsccl/fao_participant_oi_{DDMMYYYY}.csv
MARKET_CUES_NSEIX_URL=https://www.nseix.com/api/market-rate?type=derivative
MARKET_CUES_NSE_MARKET_STATUS_URL=https://www.nseindia.com/api/marketStatus
MARKET_CUES_NSE_NIFTY_FUTURES_URL=https://www.nseindia.com/api/liveEquity-derivatives?index=nse50_fut
MARKET_CUES_NSE_PREOPEN_URL=https://www.nseindia.com/api/market-data-pre-open?key=FO
