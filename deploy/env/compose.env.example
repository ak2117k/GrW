# Copy to /opt/grw/env/compose.env on the server, chmod 600. Never commit the real file.
# Generate passwords with: openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
PG_USER=grw
PG_PASSWORD=
PG_DB=grw
REDIS_PASSWORD=
# SP3 ai-engine (--profile ai): password of the read-only grw_ai role (deploy/sql/grw-ai-role.sql).
# Any characters are fine: the scorer percent-escapes it when building its DB URL
# (ai-engine/src/scorer/db_url.py). Avoid '$' (compose interpolation) and a leading space.
AI_DB_PASSWORD=
# The server's free HTTPS name: its public IP with dots replaced by dashes + .sslip.io
# e.g. IP 203.0.113.7 -> API_HOST=203-0-113-7.sslip.io  (Caddy gets the certificate itself)
API_HOST=
