  stopMovedToBE    Boolean   @default(false)
  peakPrice      Float?
  exitReason     String?

  @@index([status, enteredAt])
  @@index([alertId])
  // Per-alert de-dup checks query symbol + status together
  // (anand-dual-track.repository.ts findActiveTradedBySymbol /
  // hasTargetHitTodayBySymbol: where { symbol, status }).
  @@index([symbol, status])
  @@map("intraday_entries")
}

model SwingEntry {
  id             String    @id @default(cuid())
  symbol         String
