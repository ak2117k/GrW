// ============================================================================
// Adaptive-Stop Shadow-Track
// Cloned from the ungated-track models; adds ATR-based stop sizing fields.
// Tables: adaptive_stop_watch_entries, adaptive_stop_trades,
//         adaptive_stop_watch_events.
// ============================================================================

model AdaptiveStopWatchEntry {
  id                    String   @id @default(cuid())
  alertId               String?
  setupId               String?
  symbol                String
  token                 String
  exchange              String
  side                  String
  initialPrice          Float
  initialScore          Int
  initialBreakdown      Json
  initialAt             DateTime @default(now())
  profitTarget          Float
  profitTargetSource    String
  stopLossScore         Int      @default(60)
  status                WatchStatus @default(WATCHING)
  currentPrice          Float?
  currentScore          Int?
  currentBreakdown      Json?
  maxFavorable          Float?
  maxAdverse            Float?
  lastTickAt            DateTime?
  lastRescoreAt         DateTime?
  lastEventPrice        Float?
  paperTradeId          String?
  executedAt            DateTime?
  executedPrice         Float?
  quantity              Int?
  // Adaptive-stop sizing fields (new — not present in ungated track)
  riskAmount            Float?   // ₹ risked on this entry
  atrAtEntry            Float?   // 5m ATR(14) used to size the stop
  stopPct               Float?   // resolved stop distance as % of entry
  stopPrice             Float?   // absolute stop level
  stopBasis             String?  // 'atr' | 'floor' | 'cap'
  // Decision Gate (CORE2) outcome recorded at entry, for observability: how
  // often does the gate fail OPEN (skip on a 15m data gap) vs actually pass?
  gateSkipped           Boolean? // true = gate couldn't evaluate → failed open
  gateReason            String?  // human-readable gate decision
  gateDetail            Json?    // { nearestSupport, distSupportPct, rsi, vwapExtPct, macdHist }
  closedAt              DateTime?
  closedReason          String?
  notes                 String?
  dismissedAt           DateTime?
  partialExitedAt       DateTime?
  partialExitPrice      Float?
  partialQty            Int?
  remainingQty          Int?
  trailingHighWater     Float?
  trailingStopPrice     Float?
  // Two-strike stop-hunt guard: counts consecutive 30s polls where LTP
  // breaches the hard SL threshold. Exit fires only on the 2nd consecutive
  // breach (slBreachCount reaches 1 after first poll, exits on second poll).
  // Resets to 0 when price recovers above the SL level between polls.
  slBreachCount         Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  events                AdaptiveStopWatchEvent[]

  @@index([status])
  @@index([token])
  @@index([symbol])
  @@index([createdAt])
  @@map("adaptive_stop_watch_entries")
}

model AdaptiveStopWatchEvent {
  id            String         @id @default(cuid())
  watchEntryId  String
  watchEntry    AdaptiveStopWatchEntry @relation(fields: [watchEntryId], references: [id], onDelete: Cascade)
  eventType     WatchEventType
  price         Float?
  score         Int?
  breakdown     Json?
  priceDelta    Float?
  scoreDelta    Int?
  notes         String?
  createdAt     DateTime       @default(now())

  @@index([watchEntryId, createdAt])
  @@index([eventType])
  @@map("adaptive_stop_watch_events")
}

