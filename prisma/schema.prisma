/// Stocks under exchange surveillance / delivery-only (cautionary listings).
/// Populated two ways: (1) learned — when a live order is rejected by the broker
/// for surveillance, the symbol is upserted here so the ticket warns pre-trade
/// next time; (2) NSE lists — a daily cron upserts the official ASM/GSM/ESM sets.
/// The /market-data/cautionary endpoint ORs this against the -BE/-BZ series check.
model CautionarySymbol {
  id           String   @id @default(cuid())
  symbol       String   // base symbol, uppercase, no series suffix (e.g. "SUZLON")
  exchange     String   @default("NSE")
  token        String?
  reason       String   // 'T2T' | 'ASM' | 'GSM' | 'ESM' | 'REJECTED'
  source       String   // 'rejection' | 'nse-asm' | 'nse-gsm' | 'nse-esm'
  deliveryOnly Boolean  @default(true)
  notes        String?
  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([symbol, exchange])
  @@index([token])
  @@map("cautionary_symbols")
}

// ============================================
// Multi-Tenant Foundation (TDA-001)
// ============================================

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  CLOSED
}

enum Segment {
  INTRADAY
  SWING
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

model User {
  id              String      @id @default(cuid())
  email           String      @unique
  passwordHash    String
  role            UserRole    @default(USER)
  status          UserStatus  @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime?
  displayName     String?
  mfaEnabled      Boolean     @default(false)
  mfaSecretEnc    String?     // encrypted TOTP secret (interim AES-GCM; KMS in TDA-005)
  lastLoginAt     DateTime?
  // Designates the ONE account whose vault credentials power the shared market-data
  // feed (vault->market-feed bridge). A partial unique index (added in the migration,
  // `WHERE "isFeedAccount" = true`) enforces at most one feed account at a time.
  isFeedAccount   Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  subscriptions     Subscription[]
  brokerCredential  BrokerCredential?
  autoTradeConsents AutoTradeConsent[]
  consentRecords    ConsentRecord[]
  trades            Trade[]
  settings          UserSettings?
  alerts            Alert[]
  dailyPerformance  DailyPerformance[]
  tradeAnalyses     AITradeAnalysis[]
  weeklyReports     AIWeeklyReport[]
  auditLogs         AuditLog[]
  refreshTokens      RefreshToken[]
  verificationTokens VerificationToken[]
  billingProfile     BillingProfile?
  payments          Payment[]
  tradeTrackers      TradeTracker[]
  stockMonitors      StockMonitor[]
  @@index([status])
  @@map("users")
}

/// Stock monitor (feature: target-profit watcher). A user adds a stock with a
/// target profit %; `referencePrice` is the LTP captured at add-time and
/// `targetPrice = referencePrice * (1 + targetPercent/100)`. A poller sweeps
/// live socket prices; on `lastLtp >= targetPrice` it flips to TARGET_HIT and
/// fires an alert once.
model StockMonitor {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol         String
  exchange       String
  token          String
  referencePrice Float?
  targetPercent  Float
  targetPrice    Float?
  status         String    @default("WATCHING") // 'WATCHING' | 'TARGET_HIT'
  lastLtp        Float?
  currentPercent Float?
  triggeredAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, token])
  @@index([userId, status])
  @@map("stock_monitors")
}

/// Per-trade tracker (feature: portfolio trade tracker). One row per real Angel
/// One position/holding being tracked: entry (avg cost), exit + exit time, the
/// holding-period high/low AND the day's high/low, latest LTP + P&L%. Prices come
/// from the socket feed; entry/exit is detected from periodic broker snapshots.
model TradeTracker {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol      String
  exchange    String
  token       String
  kind        String    // 'POSITION' | 'HOLDING'
  entryPrice  Float
  qty         Float
  entryTime   DateTime  @default(now())
  exitPrice   Float?
  exitTime    DateTime?
  status      String    @default("OPEN") // 'OPEN' | 'CLOSED'
  holdingHigh Float?
  holdingLow  Float?
  dayHigh     Float?
  dayLow      Float?
  dayDate     String?   // 'YYYY-MM-DD' IST — day-rollover marker
  lastLtp     Float?
  pnl         Float?
  pnlPercent  Float?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // A partial unique index enforcing one OPEN row per (userId, token, kind) is
  // added in the migration SQL (Prisma can't express a filtered unique index).
  @@index([userId, status])
  // The two highest-frequency reads in the system are CROSS-TENANT and filter on
  // status alone: the poller's open-token sweep and the tick flush. A composite
  // index led by userId cannot serve a predicate that never mentions userId, so
  // both fall back to a seq scan over every row this table will ever hold —
  // and CLOSED trackers are never deleted, so that scan grows with the account's
  // whole trading history while the OPEN set it is looking for stays tiny.
  @@index([status])
  @@map("trade_trackers")
}

model SentinelThesis {
  id            String   @id @default(cuid())
  userId        String
  trackerId     String   @unique
  direction     String   // 'LONG' | 'SHORT'
  reason        String
  levelPrice    Float?
  targetPrice   Float?
  invalidation  Float?
  source        String   @default("INFERRED") // 'INFERRED' | 'USER'
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@map("sentinel_theses")
}

model SentinelVerdict {
  id             String   @id @default(cuid())
  userId         String
  trackerId      String
  symbol         String
  verdict        String   // 'HOLD' | 'EXIT_ARMED' | 'EXIT_NOW' | 'ESCALATE'
  confidence     String   // 'low' | 'medium' | 'high'
  thesisStatus   String   // 'INTACT' | 'WEAKENING' | 'BROKEN'
  recoveryAvailable Boolean
  reason         String
  evidence       Json
  invalidationPoint String?
  reviewInSec    Int
  packet         Json     // the full context packet, verbatim
  promptVersion  String
  triggeredBy    Json     // tripwire names that fired, or ["heartbeat"]
  netPnl         Float
  greenFloor     Float?
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([trackerId, createdAt])
  // MAX(createdAt) for the health probe's "has the sentinel produced anything?"
  // signal. Both composites above are led by a column that query does not
  // mention, so neither can serve it.
  @@index([createdAt])
  @@map("sentinel_verdicts")
}

model OiWallSnapshot {
  id           String   @id @default(cuid())
  symbol       String
  expiry       String
  callWall     Float?
  putWall      Float?
  callWallOi   Float?
  putWallOi    Float?
  capturedAt   DateTime @default(now())

  @@index([symbol, capturedAt])
  // Retention prune (SentinelRunnerService.pruneOiSnapshots) filters on
  // capturedAt ALONE. The composite above leads with `symbol`, so Postgres
  // cannot use it for that predicate and the nightly cleanup degrades to a
  // sequential scan that gets slower exactly as the table gets bigger — i.e.
  // the cleanup gets worst precisely when it matters most.
  @@index([capturedAt])
  @@map("oi_wall_snapshots")
}

model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique          // sha256 of the opaque refresh token
  familyId     String                      // rotation lineage; reuse → revoke whole family
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?                      // the token that rotated this one
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now())
  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      VerificationTokenType
  tokenHash String   @unique               // sha256 of the opaque token sent by email
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  @@index([userId, type])
  @@map("verification_tokens")
}

enum VerificationTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  segment   Segment
  status    SubscriptionStatus @default(ACTIVE)
  startedAt DateTime           @default(now())
  expiresAt DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  // TDA-015 — billing linkage (additive, nullable). The webhook maps a Razorpay
  // subscription back to this gate row via providerSubId, so no join table.
  providerSubId  String?   @unique   // razorpay subscription id
  providerPlanId String?             // razorpay plan id (segment tier)
  graceUntil     DateTime?           // dunning window end (failed-renewal grace)
  @@unique([userId, segment])
  @@index([status, expiresAt])
  @@map("subscriptions")
}

// ============================================
// Billing / Payments (TDA-015)
// ============================================

// One per user — the Razorpay customer + GST identity. A TENANT_MODEL
// (user-owned); the billing webhook worker (no request context) reaches it via
// runWithoutTenant, like SubscriptionService.
model BillingProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerCustomerId String   @unique          // razorpay customer id
  gstin              String?                    // for GST invoicing (B2B input credit)
  billingName        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  @@map("billing_profiles")
}

// The webhook idempotency / dedupe ledger. NOT a tenant model — written by the
// unauthenticated webhook worker, cross-user. Mirrors ExecutionClaim's
// insert-first at-most-once rationale (TDA-011): a RECEIVED row is inserted
// BEFORE any side effect; the @@unique([provider, eventId]) is the dedupe key.
model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String    @default("razorpay")
  eventId     String                              // provider event id (idempotency key)
  eventType   String                              // razorpay event name
  status      String    @default("RECEIVED")      // RECEIVED | PROCESSED | FAILED
  payloadHash String                              // sha256 of raw body (forensics, no PII)
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  @@unique([provider, eventId])                   // the dedupe key
  @@index([status, receivedAt])
  @@map("webhook_events")
}

// TDA-017 — per-transaction payment ledger. Tenant-owned (userId). Written by
// the billing webhook worker (runWithoutTenant, cross-user); read by the user
// via the tenant-scoped /api/me/billing/payments endpoint. Idempotent on
// providerPaymentId (a redelivered payment.captured is a no-op upsert).
model Payment {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  segment           Segment?      // null for account-level charges
  amount            Int           // minor units (paise)
  currency          String        @default("INR")
  status            PaymentStatus
  providerPaymentId String        @unique  // razorpay payment id — idempotency key
  providerInvoiceId String?
  invoiceUrl        String?
  description       String?
  createdAt         DateTime      @default(now())
  @@index([userId, createdAt])
  @@map("payments")
}

enum PaymentStatus {
  CAPTURED
  FAILED
  REFUNDED
}

model AutoTradeConsent {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  segment      Segment
  enabled      Boolean  @default(false)
  killSwitch   Boolean  @default(false)
  riskPerTrade Float?
  maxCapital   Float?
  enabledAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@unique([userId, segment])
  @@map("auto_trade_consents")
}

model ConsentDocument {
  id          String   @id @default(cuid())
  version     String   @unique
  kind        String
  body        String
  contentHash String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  records     ConsentRecord[]
  @@index([kind, active])          // TDA-009 — fast "current active doc for kind" lookup
  @@map("consent_documents")
}

model ConsentRecord {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId String
  document   ConsentDocument @relation(fields: [documentId], references: [id])
  version    String
  acceptedAt DateTime @default(now())
  ipAddress  String?
  userAgent  String?
  @@unique([userId, documentId])   // TDA-009 — one acceptance row per (user, document); makes POST /accept an idempotent upsert
  @@index([userId, version])
  @@map("consent_records")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  chainKey  String   @default("global")
  seq       BigInt
  action    String
  target    String?
  meta      Json?
  prevHash  String
  hash      String
  createdAt DateTime @default(now())
  @@unique([chainKey, seq])
  @@index([chainKey, seq])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// ============================================
// Auto-Execution — local idempotency store (TDA-011)
// ============================================
//
// At-most-once backstop for the per-user auto-execution pipeline. The pipeline
// inserts a CLAIMED row keyed by `idempotencyKey` = sha256(entryId:userId)
// BEFORE any side effect (credential decrypt / broker order), so a crash between
// claim and place errs toward a MISSED order, never a duplicate real order. The
// `@unique(idempotencyKey)` constraint is the concurrency guarantee: two
// concurrent jobs with the same key → exactly one wins the insert; the loser
// sees the conflict (P2002) and is silently skipped by the caller.
//
// NOT a tenant-scoped model (deliberately absent from TENANT_MODELS): it is
// written by the queue worker with no request context, cross-user. `userId` is
// stored for forensics and the (userId, entryId) index, not for tenant scoping.
//
// TDA-012 hardens this into a durable/transactional store with order-status
// reconciliation of CLAIMED-but-unsettled rows.
model ExecutionClaim {
  id             String    @id @default(cuid())
  idempotencyKey String    @unique                // sha256(entryId:userId) — the race backstop
  userId         String
  entryId        String
  status         String    @default("CLAIMED")    // CLAIMED | PLACED | FAILED
  brokerOrderId  String?                           // set on markPlaced
  error          String?                           // set on markFailed
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId, entryId])
  @@map("execution_claims")
}

// ============================================
// S/R Level Reaction Tracking (calibration)
// ============================================
// Persisted snapshots of evidence-weighted S/R levels (SrEvidenceService
// output) so we can later classify whether price actually respected each
// level. Snapshots are recorded at poll time; the reaction fields are
// filled in by a deferred evaluation pass that replays subsequent candles.
// Feeds scripts/sr-hold-rate.mjs which calibrates evidence weights against
// observed hold rates per evidence kind.
model SrLevelObservation {
  id             String    @id @default(cuid())
  token          String
  exchange       String
  interval       String
  price          Float
  side           String // 'resistance' | 'support'
  kinds          String[] // EvidenceKind[] that produced this level
  score          Int // 0-100 evidence score at snapshot
  ltpAtSnapshot  Float
  atr14          Float?
  snapshotAt     DateTime  @default(now())
  // ─── reaction (filled in by the deferred evaluation pass) ───
  evaluatedAt    DateTime?
  touched        Boolean?
  reaction       String? // 'REJECTED' | 'BROKE' | 'UNTOUCHED'
  reactionDetail Json?

  @@index([token, snapshotAt])
  @@index([reaction])
  @@index([reaction, snapshotAt])
  @@map("sr_level_observations")
}

// ============================================
// ML Pattern Quality Pipeline (Phase 1)
// ============================================

enum PatternOutcome {
  WIN
  LOSS
  TIMEOUT
  PENDING
}

/// One detected pattern instance + its realized ATR-follow-through outcome.
/// Feeds the ML pattern-quality scorer (see
/// docs/superpowers/specs/2026-07-14-ml-pattern-quality-pipeline-design.md).
model PatternObservation {
  id             String         @id @default(cuid())
  token          String
  exchange       String
  timeframe      String         // 1m, 3m, 5m, 10m, 15m, 30m, 1h, 1d
  patternName    String         // e.g. BULLISH_ENGULFING, DOUBLE_TOP
  category       String         // CANDLESTICK | CHART
  bias           String         // BULLISH | BEARISH
  barTime        DateTime       // anchor (signal) candle time, IST-correct instant
  candleWindow   Json           // OhlcvCandle[] up to & including the anchor bar
  atrAtDetection Float
  outcome        PatternOutcome @default(PENDING)
  label          Int?           // WIN=1, LOSS=0, null while PENDING/TIMEOUT
  // Bucket-A external context captured AT the live edge (MTF/SR/sector). Null for
  // backfill and chart-load rows — the context services are as-of-now only, so
  // only a live-edge detection can be enriched without lookahead. See the
  // DetectionContext type + 2026-07-17-ml-detection-context-enrichment-design.md.
  detectionContext Json?
  resolvedAt     DateTime?
  modelScore     Float?         // filled by later phases
  modelVersion   String?
  createdAt      DateTime       @default(now())

  @@unique([token, exchange, timeframe, patternName, barTime])
  @@index([outcome])
  @@index([timeframe])
  @@map("pattern_observations")
}

// ============================================
// Projection Zones — measured hit-rate
// ============================================

/// One confirmed zone break and how it resolved against ITS OWN target.
///
/// Deliberately separate from PatternObservation: that table's follow-through is
/// defined at a fixed k = 1.5 ATR, whereas each projection resolves against the
/// target distance it was actually drawn with. Overloading one table would put
/// two yardsticks in one label column and corrupt both.
///
/// Not tenant-scoped — zone breaks are global market data (same class as Candle
/// and PatternObservation), so the model is absent from TENANT_MODELS and rows
/// carry no userId.
/// See docs/superpowers/specs/2026-08-10-projection-zones-design.md §3.4.
model ZoneBreakObservation {
  id                 String    @id @default(cuid())
  token              String
  exchange           String
  timeframe          String
  side               String // UP | DOWN
  barTime            DateTime
  // Cohort key — what a break is grouped BY when the symbol itself has too few
  // resolved rows to speak for itself.
  zoneClassification String // STRONG | MEDIUM | WEAK
  touchCount         Int
  volumeBucket       String // LOW | NORMAL | HIGH | UNKNOWN
  htfAgreed          Boolean
  // Geometry at detection, in ATR units so it is comparable across symbols.
  atrAtDetection     Float
  targetDistAtr      Float
  stopDistAtr        Float
  targetSource       String
  // Outcome. PENDING until the horizon has enough bars to decide.
  outcome            String    @default("PENDING") // WIN | LOSS | TIMEOUT | PENDING
  label              Int? // WIN=1, LOSS=0, null while PENDING/TIMEOUT
  resolvedAt         DateTime?
  createdAt          DateTime  @default(now())

  @@unique([token, exchange, timeframe, side, barTime])
  @@index([timeframe, zoneClassification, volumeBucket])
  @@index([token, exchange, timeframe])
  @@index([outcome])
  @@map("zone_break_observations")
}

enum JobOutcome {
  RUNNING
  SUCCESS
  FAILED
  SKIPPED_LEASE
}

/// One execution of a scheduled job. The absence of rows for a jobName is the
/// signal that matters: it means the job has never run in this environment.
/// A row stuck at RUNNING with an ageing startedAt means the process died
/// mid-job — distinguishable from a job that is simply still working.
model JobRun {
  id         String     @id @default(cuid())
  jobName    String
  startedAt  DateTime   @default(now())
  finishedAt DateTime?
  outcome    JobOutcome
  error      String?
  durationMs Int?

  // Serves the per-job "when did this last run" lookup.
  @@index([jobName, startedAt])
  // Serves retention pruning, which filters on startedAt alone. The composite
  // above leads with jobName, so a btree cannot range-scan it for a bare
  // startedAt predicate — the prune would degrade to a seq scan without this.
  @@index([startedAt])
  @@map("job_runs")
}
