  // hasTargetHitTodayBySymbol: where { symbol, status }).
  @@index([symbol, status])
  @@map("swing_entries")
}

// Breakout Swing track — a breakout variant of the Anand swing (clone of
// SwingEntry + the resting-limit/queue + management fields). Lifecycle:
// QUEUED (resting limit-buy armed) -> TRADED (breakout filled) ->
// {TARGET_HIT | STOPPED | BIG_MOVER_EOD | EXPIRED | DISMISSED}.
// See docs spec 2026-06-16-breakout-swing-track.
model BreakoutSwingEntry {
  id             String    @id @default(cuid())
  symbol         String
  token          String?
  alertId        String
  scoreBreakdown Json?

  // --- breakout entry setup (resting limit-buy) ---
  signalPrice    Float                          // price at the alert
  resistance     Float?                         // nearest detected resistance
  limitPrice     Float                          // resting limit = signalPrice × (1 + LIMIT_PCT)
  prevDayClose   Float?                         // gate: current price > prev day close
  status         String    @default("QUEUED")
  queuedAt       DateTime  @default(now())

  // --- fill (null while QUEUED) ---
  entryPrice     Float?
  enteredAt      DateTime?
  quantity       Int?
  targetPct      Float     @default(10.0)
  stopPct        Float     @default(10.0)

  // --- management ---
  trailing          Boolean  @default(false)
  trailingHighWater Float?
  stopPrice         Float?                       // current effective stop (trailed after +7%)
  currentPrice      Float?
  lastTickAt        DateTime?

  // --- exit ---
  exitPrice      Float?
  exitedAt       DateTime?
  exitReason     String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([token])
  @@index([alertId])
  // Per-alert de-dup queries symbol + status together
  // (breakout-swing.repository.ts: where { symbol, status: { in [...] } }).
  @@index([symbol, status])
  @@map("breakout_swing_entries")
}

/// Day-wise OHLC of a swing trade's underlying, recorded for the holding period
/// PLUS up to 60 post-exit trading days. One row per (trade, trading day).
model SwingDailyOhlc {
  id           String     @id @default(cuid())
  swingEntryId String
  date         DateTime
  open         Float
  high         Float
  low          Float
  close        Float
  phase        String     @default("HOLD") // HOLD = on/before exit; POST_EXIT = after exit
  createdAt    DateTime   @default(now())

  swingEntry   SwingEntry @relation(fields: [swingEntryId], references: [id], onDelete: Cascade)

  @@unique([swingEntryId, date])
  @@index([swingEntryId])
  @@map("swing_daily_ohlc")
}

model SymbolLeadStat {
  id        String   @id @default(cuid())
  symbol    String
  track     String   @default("swing")
  count     Int      @default(0)
  dates     Json     @default("[]")
  lastLedAt DateTime @default(now())

  @@unique([symbol, track])
  @@map("symbol_lead_stats")
}

model ReinvestmentLot {
  id                 String    @id @default(cuid())
  symbol             String
  sourceSwingEntryId String    @unique
  capital            Float
  entryPrice         Float
  enteredAt          DateTime  @default(now())
  targetPct          Float     @default(10.0)
  stopPct            Float     @default(10.0)
  status             String    @default("OPEN")
  exitPrice          Float?
  exitedAt           DateTime?
  exitReason         String?

  @@index([status, enteredAt])
  @@index([symbol])
  @@map("reinvestment_lots")
}

model ReinvestmentPool {
  id             String @id @default("singleton")
  harvestedTotal Float  @default(0)
  deployedActive Float  @default(0)
  idleBalance    Float  @default(0)
  realizedPnl    Float  @default(0)

  @@map("reinvestment_pool")
}

/// Stocks under exchange surveillance / delivery-only (cautionary listings).
/// Populated two ways: (1) learned — when a live order is rejected by the broker
/// for surveillance, the symbol is upserted here so the ticket warns pre-trade
/// next time; (2) NSE lists — a daily cron upserts the official ASM/GSM/ESM sets.
/// The /market-data/cautionary endpoint ORs this against the -BE/-BZ series check.
model CautionarySymbol {
  id           String   @id @default(cuid())
  symbol       String   // base symbol, uppercase, no series suffix (e.g. "SUZLON")
  exchange     String   @default("NSE")
  token        String?
  reason       String   // 'T2T' | 'ASM' | 'GSM' | 'ESM' | 'REJECTED'
  source       String   // 'rejection' | 'nse-asm' | 'nse-gsm' | 'nse-esm'
  deliveryOnly Boolean  @default(true)
  notes        String?
  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([symbol, exchange])
  @@index([token])
  @@map("cautionary_symbols")
}

// ============================================
// Multi-Tenant Foundation (TDA-001)
// ============================================

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  CLOSED
}

enum Segment {
  INTRADAY
  SWING
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

model User {
  id              String      @id @default(cuid())
  email           String      @unique
  passwordHash    String
  role            UserRole    @default(USER)
  status          UserStatus  @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime?
  displayName     String?
  mfaEnabled      Boolean     @default(false)
  mfaSecretEnc    String?     // encrypted TOTP secret (interim AES-GCM; KMS in TDA-005)
  lastLoginAt     DateTime?
  // Designates the ONE account whose vault credentials power the shared market-data
  // feed (vault->market-feed bridge). A partial unique index (added in the migration,
  // `WHERE "isFeedAccount" = true`) enforces at most one feed account at a time.
  isFeedAccount   Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  subscriptions     Subscription[]
  brokerCredential  BrokerCredential?
  autoTradeConsents AutoTradeConsent[]
  consentRecords    ConsentRecord[]
  trades            Trade[]
  settings          UserSettings?
  alerts            Alert[]
  dailyPerformance  DailyPerformance[]
  tradeAnalyses     AITradeAnalysis[]
  weeklyReports     AIWeeklyReport[]
  auditLogs         AuditLog[]
  refreshTokens      RefreshToken[]
  verificationTokens VerificationToken[]
  billingProfile     BillingProfile?
  payments          Payment[]
  tradeTrackers      TradeTracker[]
  stockMonitors      StockMonitor[]
  coreStrategySelections CoreStrategySelection[]
  coreRiskLimits         CoreRiskLimit[]
  coreKillSwitches       CoreKillSwitch[]
  coreOrders             CoreOrder[]
  corePositions          CorePosition[]
  coreJournal            CoreJournal[]
  coreTradeSummaries     CoreTradeSummary[]
  coreFills              CoreFill[]
  coreCashLedger         CoreCashLedger[]
  @@index([status])
  @@map("users")
}

/// Stock monitor (feature: target-profit watcher). A user adds a stock with a
/// target profit %; `referencePrice` is the LTP captured at add-time and
/// `targetPrice = referencePrice * (1 + targetPercent/100)`. A poller sweeps
/// live socket prices; on `lastLtp >= targetPrice` it flips to TARGET_HIT and
/// fires an alert once.
model StockMonitor {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol         String
  exchange       String
  token          String
  referencePrice Float?
  targetPercent  Float
  targetPrice    Float?
  status         String    @default("WATCHING") // 'WATCHING' | 'TARGET_HIT'
  lastLtp        Float?
  currentPercent Float?
  triggeredAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, token])
  @@index([userId, status])
  @@map("stock_monitors")
}

/// Per-trade tracker (feature: portfolio trade tracker). One row per real Angel
/// One position/holding being tracked: entry (avg cost), exit + exit time, the
/// holding-period high/low AND the day's high/low, latest LTP + P&L%. Prices come
/// from the socket feed; entry/exit is detected from periodic broker snapshots.
model TradeTracker {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol      String
  exchange    String
  token       String
  kind        String    // 'POSITION' | 'HOLDING'
  entryPrice  Float
  qty         Float
  entryTime   DateTime  @default(now())
  exitPrice   Float?
  exitTime    DateTime?
  status      String    @default("OPEN") // 'OPEN' | 'CLOSED'
  holdingHigh Float?
  holdingLow  Float?
  dayHigh     Float?
  dayLow      Float?
  dayDate     String?   // 'YYYY-MM-DD' IST — day-rollover marker
  lastLtp     Float?
  pnl         Float?
  pnlPercent  Float?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // A partial unique index enforcing one OPEN row per (userId, token, kind) is
  // added in the migration SQL (Prisma can't express a filtered unique index).
  @@index([userId, status])
  // The two highest-frequency reads in the system are CROSS-TENANT and filter on
  // status alone: the poller's open-token sweep and the tick flush. A composite
  // index led by userId cannot serve a predicate that never mentions userId, so
  // both fall back to a seq scan over every row this table will ever hold —
  // and CLOSED trackers are never deleted, so that scan grows with the account's
  // whole trading history while the OPEN set it is looking for stays tiny.
  @@index([status])
  @@map("trade_trackers")
}

model SentinelThesis {
  id            String   @id @default(cuid())
  userId        String
  trackerId     String   @unique
  direction     String   // 'LONG' | 'SHORT'
  reason        String
  levelPrice    Float?
  targetPrice   Float?
  invalidation  Float?
  source        String   @default("INFERRED") // 'INFERRED' | 'USER'
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@map("sentinel_theses")
}

model SentinelVerdict {
  id             String   @id @default(cuid())
  userId         String
  trackerId      String
  symbol         String
  verdict        String   // 'HOLD' | 'EXIT_ARMED' | 'EXIT_NOW' | 'ESCALATE'
  confidence     String   // 'low' | 'medium' | 'high'
  thesisStatus   String   // 'INTACT' | 'WEAKENING' | 'BROKEN'
  recoveryAvailable Boolean
  reason         String
  evidence       Json
  invalidationPoint String?
  reviewInSec    Int
  packet         Json     // the full context packet, verbatim
  promptVersion  String
  triggeredBy    Json     // tripwire names that fired, or ["heartbeat"]
  netPnl         Float
  greenFloor     Float?
  /// The judge's machine-readable exit level as the cycle persisted it
  /// ({v:1, instrument, op, price, watch, seen} or {v:1, problem}); NULL when the
  /// verdict carried none. Read only by sentinel-executor's TriggerWatchService.
  exitTrigger    Json?
  /// News & events v2 OBSERVE mode: the {news, events} blocks the packet WOULD have
  /// carried; NULL unless NEWS_EVENTS_V2_ENABLED=observe.
  newsShadow     Json?
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([trackerId, createdAt])
  // MAX(createdAt) for the health probe's "has the sentinel produced anything?"
  // signal. Both composites above are led by a column that query does not
  // mention, so neither can serve it.
  @@index([createdAt(sort: Desc)]) // DESC, as migration 20260818130000 created it
  @@map("sentinel_verdicts")
}

/// One row per sentinel EXIT_NOW verdict the auto-exit executor picked up
/// (docs/superpowers/specs/2026-10-12-sentinel-auto-exit-design.md §6).
/// Inserted (status CLAIMED) BEFORE any broker call: the unique verdictId is the
/// idempotency anchor. No FK, like sentinel_verdicts.
model AiExitExecution {
  id            String   @id @default(cuid())
  userId        String
  verdictId     String   @unique
  trackerId     String
  symbol        String
  exchange      String?
  token         String?
  side          String?  // 'BUY' | 'SELL'
  quantity      Int?
  productType   String?  // 'INTRADAY' | 'CARRYFORWARD' | 'DELIVERY'
  orderType     String?  // 'MARKET' | 'LIMIT'
  limitPrice    Float?
  mode          String   // 'dry-run' | 'live'
  status        String   // 'CLAIMED' | 'SKIPPED' | 'DRY_RUN' | 'PLACED' | 'FILLED' | 'REJECTED' | 'FAILED'
  reason        String?
  sessionSource String?  // 'user-feed' | 'ephemeral'
  brokerOrderId String?
  brokerMessage String?
  orderStatus   String?  // last broker order-book status seen
  marketOrderId String?  // the refused MARKET order when the LIMIT fallback ran
  verdictReason String
  /// Exit discipline E7: the gate's evaluation (GateRecordV1), AI rows only.
  gate          Json?
  /// E5 execution quality. decision* = what the decision saw; order* = at send; fill* = the broker's fill.
  decisionLtp   Float?
  decisionAt    DateTime?
  orderLtp      Float?
  orderSentAt   DateTime?
  fillPrice     Float?
  fillQty       Int?
  fillAt        DateTime?
  /// fillPrice − decisionLtp (raw, contract scale)
  slippage      Float?
  /// fillAt − decisionAt, ms
  latencyMs     Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([trackerId, createdAt])
  @@map("ai_exit_executions")
}

/// Exit discipline §8: what the price did after an AI exit decision (executed or skipped).
/// One row per ai_exit_executions row scored. No FK (mirrors ai_exit_executions).
model AiExitOutcome {
  id            String    @id @default(cuid())
  executionId   String    @unique
  userId        String
  verdictId     String
  trackerId     String
  symbol        String
  exchange      String
  token         String
  kind          String    // EXECUTED | DRY_RUN | GATED | AWAITING
  positionSide  String    // LONG | SHORT
  qty           Float
  decisionPrice Float
  decisionAt    DateTime
  windowEnd     DateTime
  status        String    // PENDING | DONE | NO_DATA
  attempts      Int       @default(0)
  barsUsed      Int?
  maxAfter      Float?
  minAfter      Float?
  closeAt15     Float?
  closeAt30     Float?
  closeAt60     Float?
  closeAtEnd    Float?
  missedPnl     Float?
  savedPnl      Float?
  netAtEnd      Float?
  dataSource    String?   // candles_1m | hub-fill
  note          String?
  computedAt    DateTime?
  corpusAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId, decisionAt])
  @@index([status, windowEnd])
  @@map("ai_exit_outcomes")
}

/// One row per exitTrigger proposal the executor looked at
/// (docs/superpowers/specs/2026-10-13-sentinel-price-triggers-design.md §3.3).
/// verdictId is UNIQUE: a proposal is armed or rejected exactly once. At most one
/// ARMED row per tracker — a partial unique index in the migration SQL (Prisma
/// cannot express it). No FK, like sentinel_verdicts and ai_exit_executions.
model SentinelExitTrigger {
  id            String    @id @default(cuid())
  userId        String
  trackerId     String
  verdictId     String    @unique
  symbol        String
  instrument    String?   // 'UNDERLYING' | 'PREMIUM' (null only for MALFORMED)
  op            String?   // 'BELOW' | 'ABOVE'
  price         Float?
  watchExchange String?
  watchToken    String?
  watchSymbol   String?
  refPrice      Float?    // the watched instrument's price when armed
  status        String    // 'ARMED' | 'FIRED' | 'SUPERSEDED' | 'REJECTED' | 'EXPIRED'
  reason        String?
  armedAt       DateTime?
  endedAt       DateTime? // SUPERSEDED / EXPIRED
  firedAt       DateTime?
  firedPrice    Float?
  firedTickAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([status])
  @@index([trackerId, createdAt])
  @@map("sentinel_exit_triggers")
}

model OiWallSnapshot {
  id           String   @id @default(cuid())
  symbol       String
  expiry       String
  callWall     Float?
  putWall      Float?
  callWallOi   Float?
  putWallOi    Float?
  capturedAt   DateTime @default(now())

  @@index([symbol, capturedAt])
  // Retention prune (SentinelRunnerService.pruneOiSnapshots) filters on
  // capturedAt ALONE. The composite above leads with `symbol`, so Postgres
  // cannot use it for that predicate and the nightly cleanup degrades to a
  // sequential scan that gets slower exactly as the table gets bigger — i.e.
  // the cleanup gets worst precisely when it matters most.
  @@index([capturedAt])
  @@map("oi_wall_snapshots")
}

model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique          // sha256 of the opaque refresh token
  familyId     String                      // rotation lineage; reuse → revoke whole family
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?                      // the token that rotated this one
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now())
  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      VerificationTokenType
  tokenHash String   @unique               // sha256 of the opaque token sent by email
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  @@index([userId, type])
  @@map("verification_tokens")
}

enum VerificationTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  segment   Segment
  status    SubscriptionStatus @default(ACTIVE)
  startedAt DateTime           @default(now())
  expiresAt DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  // TDA-015 — billing linkage (additive, nullable). The webhook maps a Razorpay
  // subscription back to this gate row via providerSubId, so no join table.
  providerSubId  String?   @unique   // razorpay subscription id
  providerPlanId String?             // razorpay plan id (segment tier)
  graceUntil     DateTime?           // dunning window end (failed-renewal grace)
  @@unique([userId, segment])
  @@index([status, expiresAt])
  @@map("subscriptions")
}

// ============================================
// Billing / Payments (TDA-015)
// ============================================

// One per user — the Razorpay customer + GST identity. A TENANT_MODEL
// (user-owned); the billing webhook worker (no request context) reaches it via
// runWithoutTenant, like SubscriptionService.
model BillingProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerCustomerId String   @unique          // razorpay customer id
  gstin              String?                    // for GST invoicing (B2B input credit)
  billingName        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  @@map("billing_profiles")
}

// The webhook idempotency / dedupe ledger. NOT a tenant model — written by the
// unauthenticated webhook worker, cross-user. Mirrors ExecutionClaim's
// insert-first at-most-once rationale (TDA-011): a RECEIVED row is inserted
// BEFORE any side effect; the @@unique([provider, eventId]) is the dedupe key.
model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String    @default("razorpay")
  eventId     String                              // provider event id (idempotency key)
  eventType   String                              // razorpay event name
  status      String    @default("RECEIVED")      // RECEIVED | PROCESSED | FAILED
  payloadHash String                              // sha256 of raw body (forensics, no PII)
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  @@unique([provider, eventId])                   // the dedupe key
  @@index([status, receivedAt])
  @@map("webhook_events")
}

// TDA-017 — per-transaction payment ledger. Tenant-owned (userId). Written by
// the billing webhook worker (runWithoutTenant, cross-user); read by the user
// via the tenant-scoped /api/me/billing/payments endpoint. Idempotent on
// providerPaymentId (a redelivered payment.captured is a no-op upsert).
model Payment {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  segment           Segment?      // null for account-level charges
  amount            Int           // minor units (paise)
  currency          String        @default("INR")
  status            PaymentStatus
  providerPaymentId String        @unique  // razorpay payment id — idempotency key
  providerInvoiceId String?
  invoiceUrl        String?
  description       String?
  createdAt         DateTime      @default(now())
  @@index([userId, createdAt])
  @@map("payments")
}

enum PaymentStatus {
  CAPTURED
  FAILED
  REFUNDED
}

model AutoTradeConsent {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  segment      Segment
  enabled      Boolean  @default(false)
  killSwitch   Boolean  @default(false)
  riskPerTrade Float?
  maxCapital   Float?
  enabledAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@unique([userId, segment])
  @@map("auto_trade_consents")
}

model ConsentDocument {
  id          String   @id @default(cuid())
  version     String   @unique
  kind        String
  body        String
  contentHash String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  records     ConsentRecord[]
  @@index([kind, active])          // TDA-009 — fast "current active doc for kind" lookup
  @@map("consent_documents")
}

model ConsentRecord {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId String
  document   ConsentDocument @relation(fields: [documentId], references: [id])
  version    String
  acceptedAt DateTime @default(now())
  ipAddress  String?
  userAgent  String?
  @@unique([userId, documentId])   // TDA-009 — one acceptance row per (user, document); makes POST /accept an idempotent upsert
  @@index([userId, version])
  @@map("consent_records")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  chainKey  String   @default("global")
  seq       BigInt
  action    String
  target    String?
  meta      Json?
  prevHash  String
  hash      String
  createdAt DateTime @default(now())
  @@unique([chainKey, seq])
  @@index([chainKey, seq])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// ============================================
// Auto-Execution — local idempotency store (TDA-011)
// ============================================
//
// At-most-once backstop for the per-user auto-execution pipeline. The pipeline
// inserts a CLAIMED row keyed by `idempotencyKey` = sha256(entryId:userId)
// BEFORE any side effect (credential decrypt / broker order), so a crash between
// claim and place errs toward a MISSED order, never a duplicate real order. The
// `@unique(idempotencyKey)` constraint is the concurrency guarantee: two
// concurrent jobs with the same key → exactly one wins the insert; the loser
// sees the conflict (P2002) and is silently skipped by the caller.
//
// NOT a tenant-scoped model (deliberately absent from TENANT_MODELS): it is
// written by the queue worker with no request context, cross-user. `userId` is
// stored for forensics and the (userId, entryId) index, not for tenant scoping.
//
// TDA-012 hardens this into a durable/transactional store with order-status
// reconciliation of CLAIMED-but-unsettled rows.
model ExecutionClaim {
  id             String    @id @default(cuid())
  idempotencyKey String    @unique                // sha256(entryId:userId) — the race backstop
  userId         String
  entryId        String
  status         String    @default("CLAIMED")    // CLAIMED | PLACED | FAILED
  brokerOrderId  String?                           // set on markPlaced
  error          String?                           // set on markFailed
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId, entryId])
  @@map("execution_claims")
}

// ============================================
// S/R Level Reaction Tracking (calibration)
// ============================================
// Persisted snapshots of evidence-weighted S/R levels (SrEvidenceService
// output) so we can later classify whether price actually respected each
// level. Snapshots are recorded at poll time; the reaction fields are
// filled in by a deferred evaluation pass that replays subsequent candles.
// Feeds scripts/sr-hold-rate.mjs which calibrates evidence weights against
// observed hold rates per evidence kind.
model SrLevelObservation {
  id             String    @id @default(cuid())
  token          String
  exchange       String
  interval       String
  price          Float
  side           String // 'resistance' | 'support'
  kinds          String[] // EvidenceKind[] that produced this level
  score          Int // 0-100 evidence score at snapshot
  ltpAtSnapshot  Float
  atr14          Float?
  snapshotAt     DateTime  @default(now())
  // ─── reaction (filled in by the deferred evaluation pass) ───
  evaluatedAt    DateTime?
  touched        Boolean?
  reaction       String? // 'REJECTED' | 'BROKE' | 'UNTOUCHED'
  reactionDetail Json?

  @@index([token, snapshotAt])
  @@index([reaction])
  @@index([reaction, snapshotAt])
  @@map("sr_level_observations")
}

// ============================================
// ML Pattern Quality Pipeline (Phase 1)
// ============================================

enum PatternOutcome {
  WIN
  LOSS
  TIMEOUT
  PENDING
}

/// One detected pattern instance + its realized ATR-follow-through outcome.
/// Feeds the ML pattern-quality scorer (see
/// docs/superpowers/specs/2026-07-14-ml-pattern-quality-pipeline-design.md).
model PatternObservation {
  id             String         @id @default(cuid())
  token          String
  exchange       String
  timeframe      String         // 1m, 3m, 5m, 10m, 15m, 30m, 1h, 1d
  patternName    String         // e.g. BULLISH_ENGULFING, DOUBLE_TOP
  category       String         // CANDLESTICK | CHART
  bias           String         // BULLISH | BEARISH
  barTime        DateTime       // anchor (signal) candle time, IST-correct instant
  candleWindow   Json           // OhlcvCandle[] up to & including the anchor bar
  atrAtDetection Float
  outcome        PatternOutcome @default(PENDING)
  label          Int?           // WIN=1, LOSS=0, null while PENDING/TIMEOUT
  // Bucket-A external context captured AT the live edge (MTF/SR/sector). Null for
  // backfill and chart-load rows — the context services are as-of-now only, so
  // only a live-edge detection can be enriched without lookahead. See the
  // DetectionContext type + 2026-07-17-ml-detection-context-enrichment-design.md.
  detectionContext Json?
  resolvedAt     DateTime?
  modelScore     Float?         // filled by later phases
  modelVersion   String?
  createdAt      DateTime       @default(now())

  @@unique([token, exchange, timeframe, patternName, barTime])
  @@index([outcome])
  @@index([timeframe])
  @@map("pattern_observations")
}

// ============================================
// Projection Zones — measured hit-rate
// ============================================

/// One confirmed zone break and how it resolved against ITS OWN target.
///
/// Deliberately separate from PatternObservation: that table's follow-through is
/// defined at a fixed k = 1.5 ATR, whereas each projection resolves against the
/// target distance it was actually drawn with. Overloading one table would put
/// two yardsticks in one label column and corrupt both.
///
/// Not tenant-scoped — zone breaks are global market data (same class as Candle
/// and PatternObservation), so the model is absent from TENANT_MODELS and rows
/// carry no userId.
/// See docs/superpowers/specs/2026-08-10-projection-zones-design.md §3.4.
model ZoneBreakObservation {
  id                 String    @id @default(cuid())
  token              String
  exchange           String
  timeframe          String
  side               String // UP | DOWN
  barTime            DateTime
  // Cohort key — what a break is grouped BY when the symbol itself has too few
  // resolved rows to speak for itself.
  zoneClassification String // STRONG | MEDIUM | WEAK
  touchCount         Int
  volumeBucket       String // LOW | NORMAL | HIGH | UNKNOWN
  htfAgreed          Boolean
  // Geometry at detection, in ATR units so it is comparable across symbols.
  atrAtDetection     Float
  targetDistAtr      Float
  stopDistAtr        Float
  targetSource       String
  // Outcome. PENDING until the horizon has enough bars to decide.
  outcome            String    @default("PENDING") // WIN | LOSS | TIMEOUT | PENDING
  label              Int? // WIN=1, LOSS=0, null while PENDING/TIMEOUT
  resolvedAt         DateTime?
  createdAt          DateTime  @default(now())

  @@unique([token, exchange, timeframe, side, barTime])
  @@index([timeframe, zoneClassification, volumeBucket])
  @@index([token, exchange, timeframe])
  @@index([outcome])
  @@map("zone_break_observations")
}

enum JobOutcome {
  RUNNING
  SUCCESS
  FAILED
  SKIPPED_LEASE
}

/// One execution of a scheduled job. The absence of rows for a jobName is the
/// signal that matters: it means the job has never run in this environment.
/// A row stuck at RUNNING with an ageing startedAt means the process died
/// mid-job — distinguishable from a job that is simply still working.
model JobRun {
  id         String     @id @default(cuid())
  jobName    String
  startedAt  DateTime   @default(now())
  finishedAt DateTime?
  outcome    JobOutcome
  error      String?
  durationMs Int?

  // Serves the per-job "when did this last run" lookup.
  @@index([jobName, startedAt])
  // Serves retention pruning, which filters on startedAt alone. The composite
  // above leads with jobName, so a btree cannot range-scan it for a bare
  // startedAt predicate — the prune would degrade to a seq scan without this.
  @@index([startedAt])
  @@map("job_runs")
}

/// A browser's own account of a stalled feed. The client is the only party that
/// can see "the badge said Live while ticks were dead", and that observation
/// previously existed only in a console.warn nobody read.
model ClientFeedReport {
  id                     String   @id @default(cuid())
  userId                 String?
  health                 String   // 'stale' | 'offline'
  tickSocketUp           Boolean
  secondsSinceLastTick   Int?
  transport              String?
  subscribedTokens       Int
  namespaces             Json
  recoveredWithoutReload Boolean  @default(false)
  createdAt              DateTime @default(now())

  @@index([createdAt])
  @@map("client_feed_reports")
}

// ─── SP1 M2: market hub CandleStore ──────────────────────────────────────────
// Written and read through raw SQL in apps/api/src/modules/market-hub/candles/
// candle-repository.ts. candles_1m becomes a TimescaleDB hypertable (compressed
// after 7 days, kept 180 days) where the server has TimescaleDB; see the
// 20261008120000_sp1_m2_candle_store migration.

/// 1-minute bars: `tick` (built live) or `broker` (gap fill, nightly fix-up). broker beats tick.
model HubCandle1m {
  exchange String
  token    String
  ts       DateTime @db.Timestamptz(3)
  open     Float
  high     Float
  low      Float
  close    Float
  volume   BigInt   @default(0)
  oi       BigInt?
  source   String

  @@id([exchange, token, ts])
  @@map("candles_1m")
}

/// Angel One's native hourly bars (09:15, 10:15 … for NSE).
model HubCandle1h {
  exchange String
  token    String
  ts       DateTime @db.Timestamptz(3)
  open     Float
  high     Float
  low      Float
  close    Float
  volume   BigInt   @default(0)

  @@id([exchange, token, ts])
  @@map("candles_1h")
}

/// Official daily bars; ts = IST midnight.
model HubCandle1d {
  exchange String
  token    String
  ts       DateTime @db.Timestamptz(3)
  open     Float
  high     Float
  low      Float
  close    Float
  volume   BigInt   @default(0)

  @@id([exchange, token, ts])
  @@map("candles_1d")
}

/// Past IST days the broker has already been asked for, per series. A covered day
/// with fewer bars than the calendar expects is genuinely sparse (no trades).
model CandleCoverage {
  exchange  String
  token     String
  tf        String
  day       DateTime @db.Date
  fetchedAt DateTime @default(now()) @map("fetched_at") @db.Timestamptz(3)

  @@id([exchange, token, tf, day])
  @@map("candle_coverage")
}

// ─── SP2 M1: trade-core strategy catalogue ───────────────────────────────────
// docs/superpowers/specs/2026-10-09-sp2-core-trade-lifecycle-design.md §4.2.
// The catalogue (strategies + versions) is global and owner-curated; selections
// are per user. A trigger in the 20261009120000 migration makes a version
// immutable once it leaves DRAFT; CHECK constraints pin the string enums.

/// One strategy in the catalogue (the dropdown's top level).
model CoreStrategy {
  id              String                  @id @default(cuid())
  key             String                  @unique
  name            String
  description     String
  allowedVehicles String[]
  createdAt       DateTime                @default(now())
  versions        CoreStrategyVersion[]
  selections      CoreStrategySelection[]

  @@map("core_strategies")
}

/// A block configuration. Immutable once approved: an edit creates version n+1.
model CoreStrategyVersion {
  id          String                  @id @default(cuid())
  strategyId  String
  strategy    CoreStrategy            @relation(fields: [strategyId], references: [id])
  version     Int
  blocks      Json
  status      String                  @default("DRAFT") // DRAFT | PAPER | LIVE (SP7) | RETIRED
  createdBy   String // OWNER | AI
  approvedBy  String?
  approvedAt  DateTime?
  sourceDocId String? // core_strategy_docs.id from M6 (FK added then)
  notes       String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  selections  CoreStrategySelection[]

  @@unique([strategyId, version])
  @@index([strategyId, status])
  @@map("core_strategy_versions")
}

/// A user's choice for one strategy: which version, on or off, and its capital (₹, exact to the paisa).
model CoreStrategySelection {
  id                String              @id @default(cuid())
  userId            String
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategyId        String
  strategy          CoreStrategy        @relation(fields: [strategyId], references: [id])
  strategyVersionId String
  strategyVersion   CoreStrategyVersion @relation(fields: [strategyVersionId], references: [id])
  enabled           Boolean             @default(false)
  capitalAllocation Decimal             @db.Decimal(14, 2)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([userId, strategyId])
  @@index([strategyVersionId])
  @@map("core_strategy_selections")
}

// ─── SP2 M2: Risk Wall limits and the persistent kill switch ────────────────
// docs/superpowers/specs/2026-10-09-sp2-core-trade-lifecycle-design.md §5.2, §5.4.
// Both per-user tables are append-only (a trigger in the 20261010120000 migration
// refuses UPDATE); the row in force is the newest row whose effectiveFrom ≤ now.
// CHECK constraints pin the (key, scope) vocabulary and value shapes.

/// One limit change for one user: tighter = effective now, looser = next session open.
model CoreRiskLimit {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key           String
  scope         String // ALL | CASH_INTRADAY | MTF | OPTIONS_BUY
  numValue      Decimal? @db.Decimal(14, 2) // rupees, counts, leverage
  textValue     String? // HH:MM IST, or the daily-loss action
  effectiveFrom DateTime
  source        String // USER | USER_SETTINGS | DEFAULT
  setBy         String // the actor's userId, or SEED
  reason        String
  createdAt     DateTime @default(now())

  @@index([userId, key, scope, createdAt])
  @@map("core_risk_limits")
}

/// Seed values for limits with no UserSettings equivalent (data, owner-reviewed; D4).
model CoreRiskLimitDefault {
  key       String
  scope     String
  numValue  Decimal? @db.Decimal(14, 2)
  textValue String?
  note      String
  updatedBy String? // the admin who last edited it (null = migration seed)
  updatedAt DateTime @default(now())

  @@id([key, scope])
  @@map("core_risk_limit_defaults")
}

/// One kill switch change for one user: on = effective now, off = next session open.
model CoreKillSwitch {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  active        Boolean
  effectiveFrom DateTime
  setBy         String
  reason        String
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@map("core_kill_switch")
}

/// SP3 — one row per LLM call attempt through the AI Gateway (spec §4.6). Append-only.
model AiCall {
  id               String   @id @default(cuid())
  job              String
  provider         String
  model            String
  effort           String?
  priority         Int
  userId           String?
  positionId       String?
  setupId          String?
  decisionRecordId String?
  requestHash      String
  request          Json
  response         Json?
  errorClass       String?
  errorMessage     String?
  stopReason       String?
  inputTokens      Int?
  outputTokens     Int?
  costInr          Decimal  @default(0) @db.Decimal(12, 4)
  latencyMs        Int
  queuedMs         Int      @default(0)
  fallbackFrom     String?
  createdAt        DateTime @default(now())

  @@index([job, createdAt])
  @@index([createdAt])
  @@map("ai_calls")
}

/// SP3 — provider-neutral decision corpus (spec §5.1). Written by Node (core, later) and Python (importer).
model AiDecisionRecord {
  id                String    @id @default(cuid())
  userId            String?
  source            String    // core | sentinel | legacy:td_automation | legacy:grw_prod
  sourceId          String    // idempotency key within source
  kind              String    // ENTRY_SETUP | POSITION_REVIEW | OVERNIGHT_REVIEW | HOLDINGS_REVIEW
  decidedAt         DateTime
  symbol            String
  exchange          String?
  instrumentType    String?
  direction         String?   // LONG | SHORT
  vehicle           String?
  strategyKey       String
  strategyVersionId String?
  setupGroupKey     String
  evidence          Json
  featureSet        String?
  features          Json?
  ruleScore         Float?
  mlScore           Float?
  mlModelId         String?
  decision          Json
  aiCallIds         String[]  @default([])
  outcome           Json?
  outcomeAt         DateTime?
  createdAt         DateTime  @default(now())

  @@unique([source, sourceId])
  @@index([kind, decidedAt])
  @@index([setupGroupKey])
  @@map("ai_decision_records")
}

/// SP3 — trained model registry (spec §5.1). At most one active row per kind × instrument × horizon
/// (partial unique index in SQL, NULLs coalesced; MBM M2 widened it from per-kind).
model AiModel {
  id           String   @id
  kind         String   // xgb-entry
  featureSet   String
  trainedAt    DateTime
  dataWindow   Json
  nTrain       Int
  nHoldout     Int
  metrics      Json
  gate         String   // GO | NO_GO
  gateReasons  String[] @default([])
  artifactPath String
  active       Boolean  @default(false)
  createdAt    DateTime @default(now())
  instrument   String? // MBM: NIFTY
  horizon      String? // MBM: 30m | 60m

  @@index([kind, active])
  @@index([kind, instrument, horizon, active])
  @@map("ai_models")
}

// ─── SP2 M3: paper execution (orders, fills, cash ledger, paper defaults) ───
// docs/superpowers/specs/2026-10-11-sp2-m3-execution-design.md §4.5.
// core_fills and core_cash_ledger are append-only (a trigger in the 20261011120000
// migration refuses UPDATE, reusing M2's core_append_only_guard()). CHECK constraints pin
// the vocabularies, the ledger signs and the default shapes.

/// One core order. State changes only through execution/order-state.ts.
model CoreOrder {
  id                String           @id @default(cuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  idempotencyKey    String           @unique
  vehicle           String // CASH_INTRADAY | MTF | OPTIONS_BUY
  exchange          String
  token             String
  symbol            String
  lotSize           Int
  underlying        String?
  side              String // BUY | SELL
  qty               Int
  filledQty         Int              @default(0)
  avgFillPrice      Decimal?         @db.Decimal(14, 4)
  type              String // MARKET | LIMIT | SL_MARKET
  limitPrice        Decimal?         @db.Decimal(14, 2)
  triggerPrice      Decimal?         @db.Decimal(14, 2)
  refPrice          Decimal          @db.Decimal(14, 2)
  purpose           String // ENTRY | EXIT
  strategyVersionId String?
  /// SP2 M4: the core position this order belongs to (null for orders placed outside the lifecycle).
  positionId        String?
  position          CorePosition?    @relation(fields: [positionId], references: [id], onDelete: SetNull)
  state             String // NEW | OPEN | PARTIAL | FILLED | CANCELLED | REJECTED
  rejectReason      String?
  submittedAt       DateTime
  /// When an SL_MARKET order's trigger was first reached; a stop never un-triggers (ruling P10).
  triggeredAt       DateTime?        @map("triggered_at")
  updatedAt         DateTime         @updatedAt
  fills             CoreFill[]
  ledger            CoreCashLedger[]

  @@index([userId, state])
  @@index([state])
  @@index([userId, vehicle, token])
  @@index([userId, positionId])
  @@map("core_orders")
}

/// One fill (append-only). `charges` is the per-leg breakdown; chargesTotal is it rounded to the paisa.
model CoreFill {
  id           String           @id @default(cuid())
  orderId      String
  order        CoreOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  price        Decimal          @db.Decimal(14, 4)
  qty          Int
  charges      Json
  chargesTotal Decimal          @db.Decimal(14, 2)
  priceAt      DateTime
  createdAt    DateTime         @default(now())
  ledger       CoreCashLedger[]

  @@index([userId, createdAt])
  @@index([orderId])
  @@map("core_fills")
}

/// One signed money movement (append-only). (userId, token, interestDate) is unique; interestDate is set only on MTF_INTEREST.
model CoreCashLedger {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String // DEPOSIT | MARGIN_BLOCK | MARGIN_RELEASE | REALISED_PNL | CHARGES | MTF_INTEREST
  amount       Decimal    @db.Decimal(14, 2)
  orderId      String?
  order        CoreOrder? @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fillId       String?
  fill         CoreFill?  @relation(fields: [fillId], references: [id], onDelete: Cascade)
  token        String?
  interestDate DateTime?  @db.Date
  note         String
  createdAt    DateTime   @default(now())

  @@unique([userId, token, interestDate])
  @@index([userId, createdAt])
  @@index([orderId])
  @@map("core_cash_ledger")
}

/// Global paper settings (data, owner-editable; D4). Seeded "default — please review" except E1/E2.
model CorePaperDefault {
  key       String
  scope     String
  numValue  Decimal  @db.Decimal(14, 2)
  note      String
  updatedBy String? // the admin who last edited it (null = migration seed)
  updatedAt DateTime @default(now())

  @@id([key, scope])
  @@map("core_paper_defaults")
}

/// SP2 M4 — one core position per entry intent (spec §7.1). Status is derived from its
/// orders; the exit plan is frozen at entry; updates are guarded by `version`.
model CorePosition {
  id                String      @id @default(cuid())
  userId            String
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The corpus sourceId for ai_decision_records.source = 'core' (ruling L13).
  intentId          String      @unique
  strategyId        String
  strategyVersionId String
  vehicle           String // CASH_INTRADAY | MTF | OPTIONS_BUY
  exchange          String
  token             String
  symbol            String
  lotSize           Int
  underlying        String
  side              String // BUY | SELL
  direction         String // LONG | SHORT
  status            String // PENDING_ENTRY | OPEN | PARTIAL | EXITING | CLOSED | CANCELLED
  requestedQty      Int
  entryFilledQty    Int         @default(0)
  exitFilledQty     Int         @default(0)
  entryAvgPrice     Decimal?    @db.Decimal(14, 4)
  plan              Json
  initialStopPrice  Decimal?    @db.Decimal(14, 4)
  stopPrice         Decimal?    @db.Decimal(14, 4)
  targetPrice       Decimal?    @db.Decimal(14, 4)
  partialPrice      Decimal?    @db.Decimal(14, 4)
  partialQty        Int         @default(0)
  trailActive       Boolean     @default(false)
  partialDone       Boolean     @default(false)
  highWater         Decimal?    @db.Decimal(14, 4)
  lowWater          Decimal?    @db.Decimal(14, 4)
  exitSeq           Int         @default(0)
  exitReason        String?
  blindSince        DateTime?
  openedAt          DateTime?
  closedAt          DateTime?
  version           Int         @default(0)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  orders            CoreOrder[]
  summary           CoreTradeSummary?

  @@index([userId, status])
  @@index([status])
  @@index([userId, vehicle, token])
  @@map("core_positions")
}

// ─── SP2 M5: the journal and closed-trade summaries ─────────────────────────
// docs/superpowers/specs/2026-10-09-sp2-core-trade-lifecycle-design.md §8. Both tables are
// append-only (a trigger refuses UPDATE; DELETE happens only through the cascades).

/// One journal row (spec §8.1). A set dedupeKey makes an idempotent writer's second write a no-op.
model CoreJournal {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  positionId        String?
  strategyId        String?
  strategyVersionId String?
  intentId          String?
  symbol            String?
  payload           Json
  priceUsed         Decimal? @db.Decimal(14, 4)
  priceAgeMs        Int?
  dedupeKey         String?  @unique
  istDay            DateTime @db.Date
  createdAt         DateTime @default(now())

  @@index([userId, istDay, type])
  @@index([userId, positionId])
  @@index([intentId])
  @@index([type, istDay])
  @@map("core_journal")
}

/// One closed core position's result (spec §8.2), net of charges and MTF interest.
model CoreTradeSummary {
  id                String       @id @default(cuid())
  userId            String
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  positionId        String       @unique
  position          CorePosition @relation(fields: [positionId], references: [id], onDelete: Cascade)
  intentId          String       @unique
  strategyId        String
  strategyVersionId String
  vehicle           String
  exchange          String
  token             String
  symbol            String
  side              String
  qty               Int
  entryAvgPrice     Decimal      @db.Decimal(14, 4)
  exitAvgPrice      Decimal      @db.Decimal(14, 4)
  openedAt          DateTime
  closedAt          DateTime
  grossPnl          Decimal      @db.Decimal(14, 2)
  charges           Decimal      @db.Decimal(14, 2)
  mtfInterest       Decimal      @db.Decimal(14, 2)
  netPnl            Decimal      @db.Decimal(14, 2)
  initialRisk       Decimal?     @db.Decimal(14, 2)
  rMultiple         Decimal?     @db.Decimal(12, 4)
  mfePrice          Decimal?     @db.Decimal(14, 4)
  maePrice          Decimal?     @db.Decimal(14, 4)
  mfeRupees         Decimal?     @db.Decimal(14, 2)
  maeRupees         Decimal?     @db.Decimal(14, 2)
  holdMinutes       Int
  exitReason        String
  istDay            DateTime     @db.Date
  createdAt         DateTime     @default(now())

  @@index([userId, istDay])
  @@index([userId, strategyId, token, closedAt])
  @@map("core_trade_summaries")
}

// ─── MBM M2: market-behaviour model serving (docs/superpowers/plans/2026-10-19-mbm-m2-serving.md §1) ───
// Columns are snake_case in SQL because the Python MBM service (grw_ai role) reads/writes them directly.

/// Broker 1m bars for MBM inputs (never tick-built candles: training/serving skew). ts = bar START, UTC.
model MbmBar1m {
  series String // NIFTY, BANKNIFTY, INDIAVIX, EQ_RELIANCE, ...
  ts     DateTime @db.Timestamptz(6)
  open   Float
  high   Float
  low    Float
  close  Float
  volume Float    @default(0)
  /// NULL = the broker's historical 1m bar (source of truth). 'tick' = built from the owner's live
  /// ticks only because the historical fetch had no bar yet; the next historical upsert overwrites it.
  source String?

  @@id([series, ts])
  @@map("mbm_bars_1m")
}

/// One Model A prediction per instrument × horizon × decision time, outcome filled after the window.
model MbmPrediction {
  id                 BigInt    @id @default(autoincrement())
  instrument         String // NIFTY
  horizon            String // 30m | 60m
  asOf               DateTime  @map("as_of") @db.Timestamptz(6) // END of the last 5m bar used, UTC
  p                  Float
  regime             String // QUIET | NORMAL | ACTIVE
  q25Bp              Float?    @map("q25_bp")
  q50Bp              Float?    @map("q50_bp")
  q75Bp              Float?    @map("q75_bp")
  modelId            String    @map("model_id") // ai_models.id
  featureSet         String    @map("feature_set") // mbm-fs2
  dataQuality        String    @default("ok") @map("data_quality") // ok | gap | drivers_missing
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  outcomeRangeBp     Float?    @map("outcome_range_bp")
  outcomeThresholdBp Float?    @map("outcome_threshold_bp")
  outcomeBig         Boolean?  @map("outcome_big")
  outcomeQuality     String?   @map("outcome_quality") // ok | gap
  outcomeAt          DateTime? @map("outcome_at") @db.Timestamptz(6)
  /// Relative reading (2026-10-23): q50_bp ÷ ref_range_bp, where ref_range_bp is the median realised range
  /// (bp) of the same horizon at the same IST minute over the previous 10 sessions (causal).
  relRatio           Float?    @map("rel_ratio")
  relLabel           String?   @map("rel_label") // QUIETER | NORMAL | BUSIER | MUCH_BUSIER
  refRangeBp         Float?    @map("ref_range_bp")

  @@unique([instrument, horizon, asOf])
  @@index([instrument, asOf(sort: Desc)])
  @@map("mbm_predictions")
}

/// One option-chain capture per instrument × expiry × 5-min tick (MBM_CHAIN_CAPTURE): the training set
/// for chain/OI features. Never pruned: Angel serves nothing for expired contracts, so a lost row is gone.
model MbmChainSnapshot {
  id         BigInt   @id @default(autoincrement())
  instrument String // NIFTY
  capturedAt DateTime @map("captured_at") @db.Timestamptz(6) // when the quotes returned, UTC, whole seconds
  expiry     DateTime @db.Date
  spot       Float
  fut        Float? // nearest-month index future LTP at the same tick (null before 2026-10-22 / not quoted)
  pcr        Float? // Σ PE OI / Σ CE OI over the captured strikes
  maxPain    Float?   @map("max_pain")
  callWall   Float?   @map("call_wall") // strike with the max CE OI
  putWall    Float?   @map("put_wall") // strike with the max PE OI
  /// [{strike, ce:{ltp,oi,oi_chg,vol,iv,delta,gamma,theta,vega}, pe:{…}}], ascending strike; null = not quoted.
  strikes    Json

  @@unique([instrument, expiry, capturedAt])
  @@index([instrument, capturedAt])
  @@map("mbm_chain_snapshots")
}

/// Past intraday open interest of LIVE NIFTY futures + options, backfilled from Angel getOIData
/// (OiHistoryBackfillService). Broker APIs serve nothing for expired contracts, so a contract's rows
/// stop growing once it expires. OI only (no price): the NIFTY 1m bars are in mbm_bars_1m.
model NiftyOiHistory {
  token    String
  symbol   String
  kind     String // FUT | CE | PE
  expiry   DateTime @db.Date
  strike   Float? // null for FUT
  interval String // Angel interval: ONE_MINUTE | THREE_MINUTE | FIVE_MINUTE
  ts       DateTime @db.Timestamptz(6) // bar start, UTC
  oi       Float

  @@id([token, interval, ts])
  @@index([expiry, kind, ts])
  @@map("nifty_oi_history")
}

/// Per contract × interval: how far the nifty_oi_history backfill has walked (resumable across runs).
model NiftyOiBackfillProgress {
  token       String
  interval    String
  symbol      String
  kind        String // FUT | CE | PE
  expiry      DateTime  @db.Date
  strike      Float?
  /// Backward walk: everything from here to coveredTo has been asked; older not yet (null = not started).
  cursor      DateTime? @db.Timestamptz(6)
  /// Forward edge: everything up to here has been asked.
  coveredTo   DateTime? @map("covered_to") @db.Timestamptz(6)
  /// Consecutive backward windows (with an NSE session in them) that came back empty.
  emptyStreak Int       @default(0) @map("empty_streak")
  /// Backward walk finished (2 empty windows in a row, or the lookback floor reached).
  done        Boolean   @default(false)
  earliestTs  DateTime? @map("earliest_ts") @db.Timestamptz(6)
  latestTs    DateTime? @map("latest_ts") @db.Timestamptz(6)
  rows        Int       @default(0)
  calls       Int       @default(0)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([token, interval])
  @@map("nifty_oi_backfill_progress")
}

/// MBM daily setups monitor (OBSERVE only, touches no trade): NIFTY daily-chart signals detected at
/// 15:50 IST and their later outcomes. ret_Nd_bp = next session's open → close N sessions later, gross bp.
model MbmDailySignal {
  id         BigInt    @id @default(autoincrement())
  instrument String // NIFTY
  signalDate DateTime  @map("signal_date") @db.Date // IST session the signal fired on
  /// RIBBON_UP_MACD_GREEN_{10_30,12_26} | RIBBON_UP_TREND_{10_30,12_26} | RETEST_20D_LOW_REBOUND |
  /// BB_LOWER_TOUCH_UPTREND | BB_BREAKOUT_UP | GAP_DOWN_REVERSAL | RIBBON_DOWN_MACD_RED_{10_30,12_26}
  setup      String
  action     String // LONG_SETUP | EXIT_OR_TIGHTEN_LONGS (never a short signal)
  close      Float
  details    Json // the indicator values that fired
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  ret5dBp    Float?    @map("ret_5d_bp")
  ret10dBp   Float?    @map("ret_10d_bp")
  ret20dBp   Float?    @map("ret_20d_bp")
  outcomeAt  DateTime? @map("outcome_at") @db.Timestamptz(6) // set once all three returns are filled

  @@unique([instrument, signalDate, setup])
  @@map("mbm_daily_signals")
}

/// Overnight scorecard (docs/superpowers/specs/2026-10-20-overnight-scorecard-design.md §6): one
/// deterministic per-factor scorecard per (symbol, side, window). OBSERVE data, places nothing.
/// user_id null = a NEWS_IDEA scorecard (no position). Outcome fields are filled the next session:
/// next_open / next_close of the UNDERLYING, move_bp = (close - open) / open x 1e4, gross.
model AnalysisScorecard {
  id         String    @id @default(cuid())
  userId     String?   @map("user_id")
  symbol     String // the scored instrument (the position's tradingsymbol, or the idea's underlying)
  exchange   String
  underlying String
  side       String // BULLISH | BEARISH: the direction the position/idea needs
  window     String // OVERNIGHT | PRE_OPEN | NEWS_IDEA
  computedAt DateTime  @map("computed_at") @db.Timestamptz(6)
  factors    Json // FactorScore[]: {name, points, value, reason, available}
  total      Int
  band       String // STRONG_AGAINST | AGAINST | NEUTRAL | SUPPORTS | STRONG_SUPPORTS
  verdictId  String?   @map("verdict_id")
  nextOpen   Float?    @map("next_open")
  nextClose  Float?    @map("next_close")
  moveBp     Float?    @map("move_bp")
  filledAt   DateTime? @map("filled_at") @db.Timestamptz(6)

  @@index([userId, window, computedAt(sort: Desc)])
  @@index([symbol, computedAt(sort: Desc)])
  @@map("analysis_scorecards")
}

/// News ideas (design §4): one Sonnet call per batch marks a CE/PE/no-trade IDEA per shortlisted
/// F&O stock. Ideas only: never an order, never a paper trade. Outcome as on analysis_scorecards.
model NewsIdea {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  symbol       String
  exchange     String
  newsIds      String[]  @map("news_ids")
  headline     String
  idea         String // CE_IDEA | PE_IDEA | NO_TRADE
  rationale    String
  invalidation String
  whatToDo     String    @map("what_to_do")
  scorecardId  String?   @map("scorecard_id")
  aiCallId     String?   @map("ai_call_id")
  nextOpen     Float?    @map("next_open")
  nextClose    Float?    @map("next_close")
  moveBp       Float?    @map("move_bp")
  filledAt     DateTime? @map("filled_at") @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)])
  @@map("news_ideas")
}

// ─── Self-review loop (docs/superpowers/plans/2026-10-21-self-review-contract.md) ───────────────

/// One scored call: what the engine said vs what happened next session.
model VerificationResult {
  id          String   @id @default(cuid())
  runId       String   @map("run_id")
  sessionDate String   @map("session_date") // IST 'YYYY-MM-DD' of the session whose outcome is scored
  kind        String // SCORECARD_FACTOR | SCORECARD_TOTAL | OVERNIGHT_VERDICT | LIVE_EXIT | NEWS_IDEA | MBM_PREDICTION | MBM_RELATIVE | ...
  refId       String   @map("ref_id") // id of the scored row (scorecard id[:factor], verdict id, ai_exit id, idea id, prediction id)
  subject     String? // factor name, verdict value, horizon …
  symbol      String?
  predicted   String // what was said, short text
  actual      String // what happened, short text
  correct     Boolean? // null = not judgeable (neutral call, missing outcome)
  score       Float? // signed value where meaningful (bp moved in the called direction, ₹ saved by an exit …)
  details     Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([kind, refId])
  @@index([sessionDate, kind])
  @@map("verification_results")
}

/// One nightly self-review pass.
model SelfReviewRun {
  id          String    @id @default(cuid())
  sessionDate String    @map("session_date")
  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt  DateTime? @map("finished_at") @db.Timestamptz(6)
  status      String // RUNNING | DONE | FAILED
  summary     Json? // hit rates per kind / factor / window (rolling 1, 5, 20 sessions)
  diagnosis   Json? // LLM diagnosis of misses: [{refIds, cause, lessonKey?, proposalKey?}]
  aiCallId    String?   @map("ai_call_id")
  error       String?

  @@index([sessionDate])
  @@map("self_review_runs")
}

/// A lesson the agent reads before judging (auto, evidence-counted).
model AgentLesson {
  id         String   @id @default(cuid())
  key        String   @unique // slug, e.g. 'theta-exit-on-supported-put'
  text       String // one or two sentences, imperative
  scope      String // SENTINEL_LIVE | SENTINEL_OVERNIGHT | NEWS_IDEAS | ALL
  rightCount Int      @default(0) @map("right_count") // cases where following the lesson would have been right
  wrongCount Int      @default(0) @map("wrong_count")
  status     String   @default("ACTIVE") // ACTIVE | RETIRED
  firstSeen  DateTime @default(now()) @map("first_seen") @db.Timestamptz(6)
  lastSeen   DateTime @default(now()) @map("last_seen") @db.Timestamptz(6)
  sourceRun  String?  @map("source_run")
  sessions   String[] @default([]) // IST session dates of the misses it explained; injected only from 2

  @@index([status, scope])
  @@map("agent_lessons")
}

/// A bounded rule/weight change that needs the owner's approval in the app.
model TuningProposal {
  id            String    @id @default(cuid())
  key           String // slug; one PENDING per key
  target        String // allow-listed tunable, e.g. 'scorecard.factor.news.maxPoints'
  currentValue  Json      @map("current_value")
  proposedValue Json      @map("proposed_value")
  rationale     String
  evidence      Json // {n, right, wrong, examples:[{refId, symbol, sessionDate}]}
  status        String    @default("PENDING") // PENDING | APPROVED | REJECTED | APPLIED | EXPIRED
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  decidedAt     DateTime? @map("decided_at") @db.Timestamptz(6)
  decidedBy     String?   @map("decided_by")
  sourceRun     String?   @map("source_run")

  @@index([status, createdAt(sort: Desc)])
  @@map("tuning_proposals")
}

/// The applied value of an allow-listed tunable (consumers read this, else their code default).
model TuningOverride {
  target     String   @id
  value      Json
  proposalId String?  @map("proposal_id")
  appliedAt  DateTime @default(now()) @map("applied_at") @db.Timestamptz(6)
  appliedBy  String?  @map("applied_by")

  @@map("tuning_overrides")
}

/// Stock big-move model (docs/superpowers/plans/2026-10-22-stock-move-contract.md): one row per F&O stock per
/// scoring date. Written by the MBM service (grw_ai), read by the API. SHADOW until the owner approves points.
model StockMoveScore {
  id               BigInt    @id @default(autoincrement())
  asOf             DateTime  @map("as_of") @db.Date // IST session whose close the features use
  symbol           String // NSE cash symbol (RELIANCE, not RELIANCE-EQ)
  horizonDays      Int       @default(5) @map("horizon_days")
  thresholdAtr     Float     @default(1.5) @map("threshold_atr")
  pBig             Float     @map("p_big") // calibrated P(|ret over horizon| > threshold × ATR-equivalent)
  rankPct          Float     @map("rank_pct") // 0..1 within that day's scored book (1 = most likely)
  bucket           String // TOP20 | MID | BOTTOM20 (by rank_pct within the day)
  resultsDate      DateTime? @map("results_date") @db.Date // next announced results/board-meeting date, if known
  resultsInWindow  Boolean   @default(false) @map("results_in_window")
  atrPct           Float?    @map("atr_pct")
  close            Float?
  features         Json? // small: the top drivers for display
  modelId          String    @map("model_id")
  dataQuality      String    @default("ok") @map("data_quality")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  outcomeRetBp     Float?    @map("outcome_ret_bp") // |ret| over the horizon, filled after horizon sessions
  outcomeBig       Boolean?  @map("outcome_big")
  outcomeAt        DateTime? @map("outcome_at") @db.Timestamptz(6)

  @@unique([asOf, symbol, horizonDays, thresholdAtr])
  @@index([symbol, asOf(sort: Desc)])
  @@map("stock_move_scores")
}

/// Next-morning trade setups (stream T): built nightly from a news idea + the stock big-move model (or the NIFTY
/// MBM regime for an index). ADVISORY ONLY: never places an order, never a paper trade, never auto-trade.
/// Levels are on the underlying's cash / index chart. Outcome columns are filled after the session.
model TradeSetup {
  id                String    @id @default(cuid())
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  userId            String    @map("user_id") // whose margin sized it; only this user ever sees the row
  sessionDate       String    @map("session_date") // IST 'YYYY-MM-DD' of the session the setup is for
  symbol            String // underlying (RELIANCE, NIFTY)
  exchange          String // NFO (futures) | NSE (intraday cash)
  instrument        String // futures trading symbol, or "<SYM> intraday cash (MIS)"
  instrumentKind    String    @map("instrument_kind") // FUTURES | CASH_MIS
  instrumentToken   String?   @map("instrument_token")
  expiry            String? // IST 'YYYY-MM-DD' (futures)
  lotSize           Int?      @map("lot_size")
  side              String // LONG | SHORT (from the news idea)
  newsIdeaId        String?   @map("news_idea_id")
  entryRule         String    @map("entry_rule")
  entryRef          Float     @map("entry_ref")
  stop              Float
  stopDistance      Float     @map("stop_distance")
  target1           Float
  target2           Float
  atr               Float // daily ATR(14) of the underlying
  qty               Int // shares / units (lots × lot size)
  lots              Int?
  riskRs            Float     @map("risk_rs")
  riskPct           Float     @map("risk_pct")
  rewardT1Rs        Float     @map("reward_t1_rs")
  rewardT2Rs        Float     @map("reward_t2_rs")
  marginUsed        Float     @map("margin_used")
  marginAvailable   Float?    @map("margin_available")
  marginAsOf        DateTime? @map("margin_as_of") @db.Timestamptz(6)
  marginSource      String    @map("margin_source") // LIVE | LAST_KNOWN | PER_LAKH
  exceedsRisk       Boolean   @default(false) @map("exceeds_risk")
  inputs            Json // context lines, skip-if list, trigger, headlines, rules
  outcomeStatus     String?   @map("outcome_status") // NOT_TRIGGERED | TARGET1 | STOP | TIME_EXIT | NO_DATA
  outcomeEntryAt    DateTime? @map("outcome_entry_at") @db.Timestamptz(6)
  outcomeEntryPrice Float?    @map("outcome_entry_price")
  outcomeExitPrice  Float?    @map("outcome_exit_price")
  outcomeR          Float?    @map("outcome_r")
  outcomeHitT1      Boolean?  @map("outcome_hit_t1")
  outcomeDetails    Json?     @map("outcome_details")
  filledAt          DateTime? @map("filled_at") @db.Timestamptz(6)

  @@unique([userId, sessionDate, symbol])
  @@index([userId, sessionDate])
  @@map("trade_setups")
}

/// The owner's Angel RMS funds, snapshotted when a broker read succeeds: the "last known" margin trade setups size
/// against when the broker cannot be read at night.
model AccountMarginSnapshot {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  asOf          DateTime @default(now()) @map("as_of") @db.Timestamptz(6)
  availableCash Float    @map("available_cash")
  net           Float?

  @@index([userId, asOf(sort: Desc)])
  @@map("account_margin_snapshots")
}

// ============================================
// Telegram signal trading — stream X (signal-trader)
// docs/superpowers/plans/2026-10-23-telegram-signals-contract.md
// ============================================

/// One evaluation of one parsed Telegram signal (contract §X). Inserted as PENDING before any work:
/// UNIQUE(signalId, evaluation) is the claim, so a duplicate `signal.ready` evaluates once. A later
/// corroborating re-emit may add evaluation n+1 only to upgrade a low-confidence SKIP.
/// No FK to trade_signals / signal_clusters (stream S owns those).
model SignalDecision {
  id          String    @id @default(cuid())
  signalId    String    @map("signal_id")
  evaluation  Int       @default(1)
  clusterId   String?   @map("cluster_id")
  channelId   String?   @map("channel_id")
  userId      String?   @map("user_id")
  underlying  String?
  decidedAt   DateTime  @default(now()) @map("decided_at") @db.Timestamptz(6)
  mode        String // shadow | live
  status      String    @default("PENDING") // PENDING | DONE
  agreeCount  Int?      @map("agree_count")
  conflict    Boolean?
  /// Every hard check, in order: [{name, ok, required, detail}]
  gate        Json?
  /// {verdict, confidence, reasons[], entry, sl, targets, lots, packet, latencyMs} or {unavailable}
  judge       Json?
  /// The resolved contract + sizing: {exchange, token, tradingsymbol, lotSize, tickSize, lots, qty, limitPrice, sl, targets, riskRupees}
  plan        Json?
  decision    String? // TAKE | SKIP | PAPER (TAKE the account could not fund → paper trade; plan.paper)
  skipReason  String?   @map("skip_reason")
  aiCheck     Json?     @map("ai_check") // learning mode: the closed paper trade held against the judge's call (domain/ai-check)
  oiCheck     Json?     @map("oi_check") // the paper open's OI check, record only: {verdict, source, numbers} (domain/oi-check)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([signalId, evaluation])
  @@index([decidedAt])
  @@index([clusterId])
  @@map("signal_decisions")
}

/// The live entry order for one TAKE decision. Inserted CLAIMED before the broker call:
/// UNIQUE(decisionId) makes placement at-most-once. Always a LIMIT order.
model SignalOrder {
  id            String    @id @default(cuid())
  decisionId    String    @unique @map("decision_id")
  userId        String    @map("user_id")
  exchange      String
  token         String
  tradingsymbol String
  qty           Int
  lots          Int?
  side          String // BUY | SELL
  orderType     String    @map("order_type") // LIMIT (never MARKET)
  productType   String    @map("product_type")
  limitPrice    Float     @map("limit_price")
  sl            Float
  targets       Json
  orderTag      String    @map("order_tag")
  brokerOrderId String?   @map("broker_order_id")
  /// CLAIMED | PLACED | FILLED | PARTIAL | REJECTED | CANCELLED | UNCERTAIN | FAILED
  status        String
  statusReason  String?   @map("status_reason")
  fillPrice     Float?    @map("fill_price")
  fillQty       Int?      @map("fill_qty")
  filledAt      DateTime? @map("filled_at") @db.Timestamptz(6)
  trackerId     String?   @map("tracker_id")
  /// The synthetic sentinel_verdicts row carrying the signal SL as an exitTrigger.
  slVerdictId   String?   @map("sl_verdict_id")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@index([status])
  @@index([token, status])
  @@map("signal_orders")
}

// ============================================
// Signal intake (stream S, contract 2026-10-23): Telegram tips → TradeSignal + SignalCluster.
// No FK to telegram_messages / telegram_channels (stream R owns those): ids are kept as plain text.
// ============================================

/// One parsed tip (rule parser or LLM fallback). X reads it on `signal.ready`.
model TradeSignal {
  id              String    @id @default(cuid())
  messageId       String    @unique @map("message_id") // telegram_messages.id
  channelId       String    @map("channel_id") // telegram_channels.id
  receivedAt      DateTime  @map("received_at") @db.Timestamptz(6) // the message's postedAt
  sessionDate     String    @map("session_date") // IST 'YYYY-MM-DD' of receivedAt
  parser          String // rule | llm
  underlying      String
  instrumentKind  String    @map("instrument_kind") // FUT | CE | PE | EQ
  strike          Float?
  expiry          String? // IST 'YYYY-MM-DD'; null for EQ or when unknown (MCX without the master)
  expirySource    String?   @map("expiry_source") // message | master | rule | none
  exchange        String? // NFO | BFO | MCX | NSE — the contract resolved from the instrument master at intake (null = unresolved)
  token           String?
  tradingsymbol   String?
  side            String // BUY | SELL
  direction       String // BULL | BEAR (the market view; BUY PE = BEAR)
  entryLow        Float     @map("entry_low")
  entryHigh       Float     @map("entry_high")
  entryType       String    @map("entry_type") // ABOVE | BELOW | AT | RANGE
  sl              Float?
  targets         Json // number[] in order of distance from the entry
  qty             Int?
  horizon         String    @default("INTRADAY") // INTRADAY | BTST | POSITIONAL
  tags            String[]  @default([])
  confidence      Float
  rawText         String    @map("raw_text")
  dedupKey        String    @map("dedup_key")
  clusterId       String?   @map("cluster_id")
  outcomeStatus   String?   @map("outcome_status") // TARGET1 | SL | NEITHER | NOT_TRIGGERED | NO_DATA | NO_LEVELS | UNRESOLVED
  outcomeSession  String?   @map("outcome_session") // IST 'YYYY-MM-DD' the outcome is scored on (self-review CHANNEL_SIGNAL)
  outcomeEntryAt  DateTime? @map("outcome_entry_at") @db.Timestamptz(6)
  outcomeExitAt   DateTime? @map("outcome_exit_at") @db.Timestamptz(6)
  outcomeDetails  Json?     @map("outcome_details")
  outcomeFilledAt DateTime? @map("outcome_filled_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([underlying, receivedAt])
  @@index([channelId, receivedAt])
  @@index([dedupKey, receivedAt])
  @@index([outcomeFilledAt, sessionDate])
  @@index([outcomeSession])
  @@map("trade_signals")
}

/// Signals on the same underlying + direction inside SIGNAL_CLUSTER_MIN.
model SignalCluster {
  id          String   @id @default(cuid())
  underlying  String
  direction   String // BULL | BEAR
  windowStart DateTime @map("window_start") @db.Timestamptz(6)
  channelIds  String[] @default([]) @map("channel_ids")
  signalIds   String[] @default([]) @map("signal_ids")
  agreeCount  Int      @default(1) @map("agree_count") // distinct channels, same direction
  conflict    Boolean  @default(false) // an opposite-direction signal in the window
  status      String   @default("OPEN") // OPEN | CLOSED
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([underlying, windowStart])
  @@map("signal_clusters")
}

/// Stream S's classification of EVERY Telegram message (keep-all-data): noise / signal / update / LLM state.
model SignalMessageClass {
  messageId  String   @id @map("message_id") // telegram_messages.id
  channelId  String   @map("channel_id")
  postedAt   DateTime @map("posted_at") @db.Timestamptz(6)
  textHash   String   @map("text_hash") // sha256 of the trimmed text: the LLM-parse cache key
  status     String // NOISE | SIGNAL | UPDATE | UPDATE_ORPHAN | DUPLICATE | LLM_PENDING | LLM_NOT_SIGNAL | LLM_FAILED | LLM_SKIPPED | INFO | RECAP (VIEW = legacy INFO)
  reason     String? // pre-filter reason, parse failure, LLM error
  parser     String? // rule | llm
  llmResult  Json?    @map("llm_result") // the validated LLM reply (cache)
  signalId   String?  @map("signal_id")
  updateKind String?  @map("update_kind")
  attempts   Int      @default(0)
  /// Classifier version that wrote the row (null = before INFO/RECAP, 2026-10-24); the one-off re-classification picks up nulls.
  classVersion Int?   @map("class_version")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([textHash])
  @@index([status, postedAt])
  @@index([channelId, postedAt])
  @@map("signal_message_classes")
}

/// Structured market information from INFO posts (views, levels, OI notes, macro links) — 2026-10-24.
/// One row per message; one post can carry several items. Read-only context: never triggers a trade.
model ChannelInfo {
  id              String    @id @default(cuid())
  messageId       String    @unique @map("message_id") // telegram_messages.id
  channelId       String    @map("channel_id") // telegram_channels.id
  postedAt        DateTime  @map("posted_at") @db.Timestamptz(6)
  sessionDate     String    @map("session_date") // IST 'YYYY-MM-DD' of postedAt
  textHash        String    @map("text_hash") // the LLM-info cache key
  items           Json // InfoItem[]: {underlying, bias, levels, targetLevel, oi, condition, horizon}
  extractor       String // rule | llm
  confidence      Float
  llmReply        Json?     @map("llm_reply") // the cheap-LLM reply (cache), when the fallback ran
  outcomes        Json? // per item: {status, session, ret, band, levelHit} (self-review CHANNEL_INFO)
  outcomeSession  String?   @map("outcome_session")
  outcomeFilledAt DateTime? @map("outcome_filled_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([postedAt])
  @@index([channelId, postedAt])
  @@index([textHash])
  @@index([outcomeSession])
  @@index([outcomeFilledAt, postedAt])
  @@map("channel_infos")
}

/// A breakout level a channel posted ("Radico breakout above 4330"), watched on the underlying's LTP
/// until it is crossed (→ a trade_signals row + signal.ready, judged like any call) or expires (owner 2026-10-27).
model SignalWatch {
  id          String    @id @default(cuid())
  messageId   String    @map("message_id") // telegram_messages.id of the post
  itemIndex   Int       @map("item_index") // which channel_infos item
  channelId   String    @map("channel_id")
  postedAt    DateTime  @map("posted_at") @db.Timestamptz(6)
  underlying  String
  instrumentKind String @map("instrument_kind") // EQ (stock) | FUT (index / commodity)
  side        String // BUY (breakout above) | SELL (breakdown below)
  level       Float
  exchange    String? // the underlying's quote line
  token       String?
  status      String    @default("ACTIVE") // ACTIVE | FIRED | EXPIRED | INVALID
  reason      String?
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  lastLtp     Float?    @map("last_ltp")
  lastCheckAt DateTime? @map("last_check_at") @db.Timestamptz(6)
  firedAt     DateTime? @map("fired_at") @db.Timestamptz(6)
  signalId    String?   @map("signal_id") // trade_signals.id created when it fired
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([messageId, itemIndex])
  @@index([status, expiresAt])
  @@map("signal_watches")
}

/// Live exit rules recorded beside a paper trade, never acted on (owner 2026-10-28, paper-exit-shadow spec).
/// One row per (trade, rule): STOP | FLOOR | GIVEBACK | AI_EXIT = the first time that rule would have exited;
/// TRACK = the running state (peak, floor latches, noise unit). Settled (held / rule P&L) when the trade closes.
model PaperExitShadow {
  id          String    @id @default(cuid())
  tradeId     String    @map("trade_id")
  decisionId  String?   @map("decision_id")
  rule        String
  wouldExitAt DateTime? @map("would_exit_at") @db.Timestamptz(6)
  price       Float?
  reason      String?
  detail      Json?
  heldPnl     Float?    @map("held_pnl") // gross ₹ of the paper trade as actually held
  rulePnl     Float?    @map("rule_pnl") // gross ₹ had this rule exited it
  saved       Float? // rulePnl − heldPnl (> 0: exiting by this rule beat holding)
  settledAt   DateTime? @map("settled_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tradeId, rule])
  @@index([settledAt])
  @@map("paper_exit_shadows")
}

/// Paper sentinel (paper exit shadow stage 2): every look the live AI sentinel took at an open PAPER
/// trade. The same columns as sentinel_verdicts, deliberately in a separate table: the live trigger
/// watcher and the auto-exit executor read sentinel_verdicts, and a paper row must never reach them.
/// trackerId is `paper:<tradeId>`. No FK, like sentinel_verdicts.
model PaperSentinelLook {
  id                String   @id @default(cuid())
  tradeId           String
  userId            String
  trackerId         String
  symbol            String
  verdict           String
  confidence        String
  thesisStatus      String
  recoveryAvailable Boolean
  reason            String
  evidence          Json
  invalidationPoint String?
  reviewInSec       Int
  packet            Json
  promptVersion     String
  triggeredBy       Json
  netPnl            Float
  greenFloor        Float?
  exitTrigger       Json?
  newsShadow        Json?
  createdAt         DateTime @default(now())

  @@index([trackerId, createdAt])
  @@index([tradeId])
  @@map("paper_sentinel_looks")
}

// ─── News impact (2026-10-24): cluster → classify → relevance → batched cheap-LLM impact → reactions ───

/// One story across sources (layer 1). Coverage (sourceCount) is a feature. Boilerplate never goes further.
model NewsCluster {
  id             String   @id @default(cuid())
  headline       String
  instruments    String[] @default([])
  sectors        String[] @default([])
  indices        String[] @default([])
  sources        String[] @default([])
  sourceCount    Int      @default(1) @map("source_count")
  articleIds     String[] @default([]) @map("article_ids")
  titleTokens    String[] @default([]) @map("title_tokens")
  firstSeen      DateTime @map("first_seen") @db.Timestamptz(6)
  lastSeen       DateTime @map("last_seen") @db.Timestamptz(6)
  materialType   String   @map("material_type") // RESULTS | ORDER_WIN | … | BOILERPLATE | OTHER | NEWS
  material       Boolean  @default(false)
  boilerplate    Boolean  @default(false)
  relevance      Float    @default(0)
  reasons        String[] @default([])
  impactAttempts Int      @default(0) @map("impact_attempts")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([lastSeen])
  @@index([firstSeen])
  @@map("news_clusters")
}

/// The cheap model's read of one cluster (layer 2). One row per cluster; re-analysed only when coverage doubles.
model NewsImpact {
  id            String    @id @default(cuid())
  clusterId     String    @unique @map("cluster_id")
  analysedAt    DateTime  @map("analysed_at") @db.Timestamptz(6)
  model         String
  sourceCountAt Int       @map("source_count_at")
  direction     String // BULL | BEAR | NEUTRAL
  magnitude     String // LOW | MED | HIGH
  horizon       String // INTRADAY | DAYS | WEEKS
  symbols       String[]  @default([])
  sectors       String[]  @default([])
  indexName     String?   @map("index_name") // NIFTY | BANKNIFTY
  pricedIn      Boolean   @map("priced_in")
  confidence    Float
  oneLine       String    @map("one_line")
  rank          Float     @default(0)
  analyses      Int       @default(1)
  alertedAt     DateTime? @map("alerted_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([analysedAt])
  @@map("news_impacts")
}

/// The market's reaction to an analysed cluster, per affected symbol / index (layer 4, factor collection).
model NewsReaction {
  id           String    @id @default(cuid())
  impactId     String    @map("impact_id")
  clusterId    String    @map("cluster_id")
  symbol       String
  kind         String // INDEX | STOCK
  direction    String
  magnitude    String
  horizon      String
  anchorAt     DateTime  @map("anchor_at") @db.Timestamptz(6)
  anchorIsOpen Boolean   @default(false) @map("anchor_is_open")
  judgeSession String?   @map("judge_session") // IST 'YYYY-MM-DD' the self-review scores it on
  p0           Float?
  p15          Float?
  p60          Float?
  pClose       Float?    @map("p_close")
  pNextClose   Float?    @map("p_next_close")
  atr          Float?
  complete     Boolean   @default(false)
  filledAt     DateTime? @map("filled_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([clusterId, symbol])
  @@index([complete, anchorAt])
  @@index([judgeSession])
  @@map("news_reactions")
}

/// AI advisor multi-turn memory (owner's Claude chat). Last few turns per user, trimmed server-side;
/// cleared by "New chat". Read-only context for the advisor; never drives trading.
model AdvisorChatTurn {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  role      String // user | assistant
  content   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt])
  @@map("advisor_chat_turns")
}

/// Research log (NOT a signal): every NIFTY S/R zone break the app's zone detector sees, the front-month
/// futures OI around it, and the follow-through filled later — to re-test the OI-confirmed-break effect
/// on unseen breaks (grw-mbm research/oi-pattern, 2026-10-23). Nothing in trading reads this table.
model LevelBreakLog {
  id              String    @id @default(cuid())
  instrument      String // NIFTY
  timeframe       String // 15m | 60m
  direction       String // UP | DOWN
  /// Break bar END (UTC) — the moment the break is known.
  ts              DateTime  @db.Timestamptz(6)
  /// The broken edge (resistance upper / support lower).
  level           Float
  zoneType        String    @map("zone_type") // resistance | support
  zoneUpper       Float     @map("zone_upper")
  zoneLower       Float     @map("zone_lower")
  classification  String // STRONG | MEDIUM | WEAK
  touchCount      Int       @map("touch_count")
  /// Timeframe ATR(14) at the break.
  atr             Float
  /// Break bar close.
  price           Float
  /// nifty_oi_history FIVE_MINUTE front-month FUT.
  futToken        String?   @map("fut_token")
  futOiNow        Float?    @map("fut_oi_now")
  futOi15mBefore  Float?    @map("fut_oi_15m_before")
  futOiChange     Float?    @map("fut_oi_change")
  priceAt15m      Float?    @map("price_at_15m")
  priceAt60m      Float?    @map("price_at_60m")
  priceEod        Float?    @map("price_eod")
  /// Signed in the break direction (positive = followed through), points.
  move15mPts      Float?    @map("move_15m_pts")
  move60mPts      Float?    @map("move_60m_pts")
  moveEodPts      Float?    @map("move_eod_pts")
  mfeEodPts       Float?    @map("mfe_eod_pts")
  maeEodPts       Float?    @map("mae_eod_pts")
  outcomeFilledAt DateTime? @map("outcome_filled_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([instrument, timeframe, ts, direction, level])
  @@index([outcomeFilledAt, ts])
  @@map("level_break_log")
}

/// "Noise or real?" read taken when an AI exit fires (owner 2026-10-30, modules/exit-noise). RECORD ONLY:
/// written after the exit decision, never read by an exit path. source = paper | signal_paper | real;
/// ref_id = the paper trade id or the real exit's verdict id. The follow-up columns (underlying 15 / 30 min
/// later, excursions over the 30 min) are filled by ExitNoiseFollowCron for the night review's scoring.
/// Written and read with raw SQL (exit-noise.repository.ts).
model ExitNoiseRead {
  id                 String    @id @default(cuid())
  source             String
  refId              String    @map("ref_id")
  tradeId            String?   @map("trade_id")
  trackerId          String?   @map("tracker_id")
  userId             String?   @map("user_id")
  symbol             String
  exchange           String?
  underlying         String?
  underlyingExchange String?   @map("underlying_exchange")
  underlyingToken    String?   @map("underlying_token")
  side               String // LONG | SHORT
  want               String // BULLISH | BEARISH
  exitRule           String    @map("exit_rule") // AI_EXIT | AI_TRIGGER
  exitPrice          Float?    @map("exit_price")
  exitAt             DateTime  @map("exit_at") @db.Timestamptz(6)
  underlyingAtExit   Float?    @map("underlying_at_exit")
  noiseN             Float?    @map("noise_n")
  verdict            String // NOISE | REAL | MIXED | NO_DATA
  read               Json // NoiseRead (exit-noise/domain/noise-read.ts)
  underlyingAfter15m Float?    @map("underlying_after_15m")
  underlyingAfter30m Float?    @map("underlying_after_30m")
  maxFavour30m       Float?    @map("max_favour_30m")
  maxAgainst30m      Float?    @map("max_against_30m")
  followedAt         DateTime? @map("followed_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([source, refId, exitRule])
  @@index([exitAt])
  @@index([followedAt, exitAt])
  @@map("exit_noise_reads")
}
