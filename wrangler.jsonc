{
  // Cloudflare Worker that serves the GrW SPA (static assets) AND proxies API
  // calls to the Render backend server-side, so the browser makes only
  // same-origin requests (no CORS). Cloudflare Pages _redirects CANNOT proxy to
  // an external origin (200 rewrites are same-site only), which is why this is a
  // Worker-with-assets, not a plain Pages static site.
  //
  // Deploy: the connected Cloudflare project runs `npx wrangler deploy` from the
  // repo root after the build command produces apps/web/dist. See
  // docs/deploy/FREE-DEPLOY-RUNBOOK.md.
  "name": "grw",
  "compatibility_date": "2025-06-01",
  "main": "worker/index.js",
  // API host the Worker proxies to: the Mumbai/Noida VPS behind Caddy (SP0 cutover 2026-10-09).
  // Render stays suspended as the 14-day fallback (FALLBACK_API_ORIGIN in worker/index.js).
  "vars": { "API_ORIGIN": "https://157-10-98-70.sslip.io" },
  "assets": {
    "directory": "apps/web/dist",
    "binding": "ASSETS",
    // Serve index.html for unknown paths so react-router client routes
    // (/login, /dashboard, ...) resolve on hard refresh.
    "not_found_handling": "single-page-application",
    // Run the Worker (proxy) ONLY for these paths; everything else is served
    // directly from the static assets with no Worker invocation. /socket.io/*
    // MUST be here — otherwise the WebSocket handshake is served the SPA
    // index.html instead of being proxied to Render, and the live feed never
    // connects (the app shows "Disconnected").
    "run_worker_first": ["/api/*", "/auth/*", "/socket.io/*"]
  }
}
